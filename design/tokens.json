{
  "$comment": [
    "THE single source of truth for every colour, size and duration in Dray.",
    "Colour is authored in OKLCH as [L, C, H]. Never author hex anywhere else.",
    "",
    "  node build/gen-tokens.mjs      -> src/Dray.Ui/wwwroot/css/tokens.css + src/Dray.Core/Theme/Tokens.g.cs",
    "  node build/verify-contrast.mjs -> fails if any pair in `contrast` regresses",
    "  node build/lint-tokens.mjs     -> fails on raw hex/rgb/hsl outside generated files",
    "",
    "See DESIGN.md for the reasoning behind each value."
  ],

  "meta": { "name": "Dray", "colorSpace": "oklch" },

  "primitives": {
    "$comment": "Never referenced by a component. Semantic roles below point at these.",
    "white":     [1.000, 0.000, 0],
    "clay-100":  [0.972, 0.004, 41],
    "clay-200":  [0.945, 0.005, 41],
    "clay-300":  [0.890, 0.006, 41],
    "clay-400":  [0.638, 0.012, 41],
    "clay-500":  [0.550, 0.150, 41],
    "clay-600":  [0.480, 0.147, 41],
    "clay-700":  [0.520, 0.011, 41],
    "clay-900":  [0.235, 0.014, 41],

    "coal-100":  [0.945, 0.005, 41],
    "coal-300":  [0.700, 0.010, 41],
    "coal-400":  [0.520, 0.010, 41],
    "coal-600":  [0.330, 0.006, 41],
    "coal-700":  [0.275, 0.005, 41],
    "coal-800":  [0.235, 0.004, 41],
    "coal-900":  [0.185, 0.000, 0],

    "ember-400": [0.705, 0.140, 46],
    "ember-500": [0.760, 0.130, 48],

    "petrol-500":[0.330, 0.067, 232],
    "petrol-400":[0.680, 0.100, 228],

    "moss-500":  [0.520, 0.136, 152],
    "moss-400":  [0.740, 0.145, 152],
    "moss-tint": [0.955, 0.028, 152],
    "moss-ink":  [0.400, 0.105, 152],

    "amber-500": [0.660, 0.137, 78],
    "amber-400": [0.800, 0.145, 82],
    "amber-tint":[0.962, 0.033, 78],
    "amber-ink": [0.430, 0.099, 62],

    "rust-500":  [0.415, 0.165, 13],
    "rust-300":  [0.700, 0.170, 14],
    "rust-400":  [0.625, 0.215, 12],
    "rust-tint": [0.955, 0.022, 18],
    "rust-ink":  [0.435, 0.174, 18]
  },

  "semantic": {
    "$comment": "What components actually use. A component may reference ONLY these.",

    "light": {
      "bg":            "white",
      "surface":       "clay-100",
      "surface-2":     "clay-200",
      "line":          "clay-300",
      "line-strong":   "clay-400",
      "ink":           "clay-900",
      "muted":         "clay-700",
      "brand":         "clay-500",
      "brand-hi":      "clay-600",
      "on-brand":      "white",
      "accent":        "petrol-500",
      "on-accent":     "white",
      "focus":         "clay-500",
      "ok":            "moss-500",
      "warn":          "amber-500",
      "danger":        "rust-500",
      "on-danger":     "white",
      "ok-tint":       "moss-tint",
      "ok-ink":        "moss-ink",
      "warn-tint":     "amber-tint",
      "warn-ink":      "amber-ink",
      "danger-tint":   "rust-tint",
      "danger-ink":    "rust-ink",
      "neutral-tint":  "clay-200",
      "neutral-ink":   "clay-700"
    },

    "dark": {
      "bg":            "coal-900",
      "surface":       "coal-800",
      "surface-2":     "coal-700",
      "line":          "coal-600",
      "line-strong":   "coal-400",
      "ink":           "coal-100",
      "muted":         "coal-300",
      "brand":         "ember-400",
      "brand-hi":      "ember-500",
      "on-brand":      "coal-900",
      "accent":        "petrol-400",
      "on-accent":     "coal-900",
      "focus":         "ember-400",
      "ok":            "moss-400",
      "warn":          "amber-400",
      "danger":        "rust-400",
      "on-danger":     "coal-900",
      "ok-tint":       { "mix": "moss-400", "into": "coal-900", "amount": 0.18 },
      "ok-ink":        "moss-400",
      "warn-tint":     { "mix": "amber-400", "into": "coal-900", "amount": 0.18 },
      "warn-ink":      "amber-400",
      "danger-tint":   { "mix": "rust-400", "into": "coal-900", "amount": 0.18 },
      "danger-ink":    "rust-300",
      "neutral-tint":  "coal-700",
      "neutral-ink":   "coal-300"
    }
  },

  "effects": {
    "$comment": [
      "Compositing effects rather than palette entries: they carry alpha and are not subject to",
      "contrast rules, so they live here instead of in `semantic`. Raw CSS, emitted per theme.",
      "DESIGN.md section 4: elevation is borders and background steps. Exactly two shadows exist,",
      "both for genuinely floating layers. Cards do not get shadows. Rows do not get shadows."
    ],
    "light": {
      "scrim": "oklch(0 0 0 / 32%)",
      "shadow-popover": "0 2px 8px -2px oklch(0 0 0 / 12%), 0 4px 16px -8px oklch(0 0 0 / 16%)",
      "shadow-dialog": "0 12px 48px -12px oklch(0 0 0 / 28%)"
    },
    "dark": {
      "scrim": "oklch(0 0 0 / 52%)",
      "shadow-popover": "0 2px 8px -2px oklch(0 0 0 / 45%), 0 4px 16px -8px oklch(0 0 0 / 55%)",
      "shadow-dialog": "0 12px 48px -12px oklch(0 0 0 / 70%)"
    }
  },

  "scale": {
    "space":  { "s1": "4px", "s2": "8px", "s3": "12px", "s4": "16px", "s5": "24px", "s6": "32px", "s7": "48px" },
    "radius": { "r-sm": "4px", "r-md": "6px", "r-lg": "10px" },
    "text": {
      "xs":   { "size": "0.6875rem", "weight": 500, "lh": 1.35 },
      "sm":   { "size": "0.75rem",   "weight": 400, "lh": 1.45 },
      "base": { "size": "0.8125rem", "weight": 400, "lh": 1.5 },
      "md":   { "size": "0.9375rem", "weight": 500, "lh": 1.45 },
      "lg":   { "size": "1.125rem",  "weight": 600, "lh": 1.3 },
      "xl":   { "size": "1.5rem",    "weight": 600, "lh": 1.2 }
    },
    "z": { "sticky": 10, "dropdown": 20, "overlay": 30, "dialog": 40, "toast": 50, "tooltip": 60 },
    "motion": { "fast": "150ms", "base": "200ms", "slow": "250ms", "ease": "cubic-bezier(0.22, 1, 0.36, 1)" },
    "density": {
      "comfortable": { "row-h": "36px", "row-pad-y": "8px", "table-text": "0.75rem" },
      "compact":     { "row-h": "28px", "row-pad-y": "4px", "table-text": "0.6875rem" }
    }
  },

  "contrast": {
    "$comment": "Checked by build/verify-contrast.mjs in CI. `min` is the WCAG ratio that must hold.",
    "rules": [
      { "fg": "ink",         "bg": "bg",          "min": 4.5, "label": "body text" },
      { "fg": "ink",         "bg": "surface",     "min": 4.5, "label": "body on surface" },
      { "fg": "ink",         "bg": "surface-2",   "min": 4.5, "label": "body on chrome" },
      { "fg": "muted",       "bg": "bg",          "min": 4.5, "label": "secondary text / placeholder" },
      { "fg": "muted",       "bg": "surface",     "min": 4.5, "label": "secondary on surface" },
      { "fg": "line-strong", "bg": "bg",          "min": 3.0, "label": "control border" },
      { "fg": "line-strong", "bg": "surface",     "min": 3.0, "label": "control border on surface" },
      { "fg": "focus",       "bg": "bg",          "min": 3.0, "label": "focus ring" },
      { "fg": "brand",       "bg": "bg",          "min": 3.0, "label": "brand as icon/text" },
      { "fg": "on-brand",    "bg": "brand",       "min": 4.5, "label": "text on primary button" },
      { "fg": "on-brand",    "bg": "brand-hi",    "min": 4.5, "label": "text on primary hover" },
      { "fg": "accent",      "bg": "bg",          "min": 4.5, "label": "link text" },
      { "fg": "on-accent",   "bg": "accent",      "min": 4.5, "label": "text on accent fill" },
      { "fg": "on-danger",   "bg": "danger",      "min": 4.5, "label": "text on destructive button" },
      { "fg": "ok",          "bg": "bg",          "min": 3.0, "label": "ok as icon" },
      { "fg": "warn",        "bg": "bg",          "min": 3.0, "label": "warn as icon" },
      { "fg": "danger",      "bg": "bg",          "min": 3.0, "label": "danger as icon" },
      { "fg": "ok-ink",      "bg": "ok-tint",     "min": 4.5, "label": "running pill" },
      { "fg": "warn-ink",    "bg": "warn-tint",   "min": 4.5, "label": "paused pill" },
      { "fg": "danger-ink",  "bg": "danger-tint", "min": 4.5, "label": "failed pill" },
      { "fg": "neutral-ink", "bg": "neutral-tint","min": 4.5, "label": "exited pill" }
    ],

    "separation": {
      "$comment": [
        "Two saturated fills a user must never confuse. Luminance ratio, not WCAG.",
        "A pair satisfies the rule by EITHER a luminance ratio >= `min` OR a hue difference",
        ">= `minHueDelta`. Large hue separation on the blue-yellow axis stays distinguishable",
        "to the most common colour vision deficiencies even at matched lightness, so demanding",
        "luminance separation as well would be a false constraint."
      ],
      "minHueDelta": 60,
      "rules": [
        { "a": "brand", "b": "danger", "min": 1.7, "label": "primary vs destructive button" },
        { "a": "brand", "b": "accent", "min": 1.7, "label": "brand vs accent fill" }
      ]
    },

    "exceptions": {
      "$comment": [
        "Deliberate, reasoned departures. Each names the compensating control.",
        "Removing an exception silently is impossible: the verifier fails if an exception",
        "is declared for a pair that now passes, so stale entries surface immediately."
      ],
      "warn-never-filled": {
        "applies": "light+dark",
        "rule": "white text on `warn`",
        "reason": "Amber at a readable luminance cannot carry white text (2.72:1). Authored for icons, borders and the warn-ink pill pair only.",
        "control": "There is no amber filled button anywhere in Dray. Enforced by review; `on-warn` is deliberately not a token."
      },
      "dark-brand-vs-danger": {
        "applies": "dark",
        "rule": "separation brand vs danger",
        "reason": "On a dark ground both must clear 4.5:1, which compresses them into one luminance band. They are 34 degrees apart in hue and unmistakable in colour.",
        "control": "In dark mode a destructive button is never a saturated fill: danger-tint background, danger text, danger border, trash glyph. Only the brand gets a filled button."
      }
    }
  }
}
