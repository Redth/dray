<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- One source. The MAUI macOS and GTK4 platform previews publish to nuget.org, so the
         dnceng dotnet10 feed is not needed; a single source also keeps central package
         management from requiring source mapping (NU1507). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- A machine-level config can disable a source, and clearing packageSources above does not
       undo that. Without this, a developer who has nuget.org disabled globally gets an
       unresolvable NU1103 naming only the feeds they can still see. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
