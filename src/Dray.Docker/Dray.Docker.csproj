<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dray.Docker</RootNamespace>
    <Description>
      IContainerRuntime over the Docker Engine API. One implementation of the seam; Apple's
      container framework can be another without touching a page.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The X509 companion package targets the 3.x credentials model; 4.x configures TLS
         through the transport's ConfigureHandler instead, so it is not needed. -->
    <PackageReference Include="Docker.DotNet.Enhanced" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dray.Core/Dray.Core.csproj" />
  </ItemGroup>

</Project>
