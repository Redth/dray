<!--
  The one XAML file in Dray, and it holds no UI.

  WinUI's application object has to be declared in XAML for the XAML compiler to generate Main,
  the type-metadata provider WinUI controls resolve their templates through, and the hook-up of
  XamlControlsResources. A XAML-free application can be written, but it means hand-writing all three
  and keeping them in step with the Windows App SDK — the kind of thing to adopt once it is proven on
  a Windows machine, not before. Everything visible is Blazor, or WinUI built in C#.
-->
<maui:MauiWinUIApplication
    x:Class="Dray.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui">

</maui:MauiWinUIApplication>
