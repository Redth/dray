@page "/images"
@inject EngineManager Engine
@inject IShellBridge Shell
@inject PruneService Prune
@inject ShellCapabilities Caps
@inject NavigationManager Nav

<PageChromeScope Chrome="Chrome" OnAction="HandleAction" OnSearch="s => _search = s" OnFilter="HandleFilter" />

<EngineScope>
    <div class="page page--flush">
        @if (_notice is { } notice)
        {
            <div class="banner @(_noticeOk ? "banner--ok" : null)" role="status">
                <Icon Name="@(_noticeOk ? IconRef.Check : IconRef.Warning)" Size="IconSize.Sm" />
                <span>@notice</span>
                <Button Label="Dismiss" Icon="IconRef.Close" IconOnly="true" Variant="ButtonVariant.Ghost"
                        OnClick="() => _notice = null" />
            </div>
        }

        @if (Engine.HasNoHosts)
        {
            <NoEngine />
        }
        else if (_error is { } error)
        {
            <EmptyState Icon="IconRef.Warning" Title="Could not list images" Body="@error">
                <Actions>
                    <Button Label="Try again" Icon="IconRef.Refresh" OnClick="LoadAsync" />
                </Actions>
            </EmptyState>
        }
        else if (_images is null)
        {
            <div class="stack-v">
                @for (var i = 0; i < 6; i++)
                {
                    <Skeleton Width="@($"{45 + (i * 11 % 40)}%")" />
                }
            </div>
        }
        else if (Visible.Count == 0)
        {
            <EmptyState Icon="IconRef.Image"
                        Title="@(_search.Length > 0 ? "No images match" : "No images")"
                        Body="@(_search.Length > 0
                            ? "Nothing here matches the current search."
                            : "This engine has no images. Pull one to get started.")">
                <Actions>
                    <Button Label="Pull an image…" Icon="IconRef.Pull" Variant="ButtonVariant.Primary"
                            OnClick="() => _pulling = true" />
                </Actions>
            </EmptyState>
        }
        else
        {
            @* The shared table. Which columns exist and what they say come from ImageGrid, in
               Core, where the judgement about which fact matters more than which other is
               testable. *@
            <DataTable TRow="ImageSummary"
                       Columns="ImageGrid.Columns()"
                       Rows="Visible"
                       Values="i => ImageGrid.Row(i)"
                       Key="i => i.Id"
                       ActionsFor="ActionsFor"
                       OnAction="RunRowActionAsync"
                       OnRowOpen="OpenById"
                       Placeholder="No images" />
        }
    </div>

    @if (_tagging is { } tagging)
    {
        <TagDialog @key="tagging.Id" Image="tagging" Open="true"
                   OpenChanged="open => _tagging = open ? tagging : null" OnTagged="LoadAsync" />
    }

    @if (_pushing is { } pushing)
    {
        <PushDialog @key="pushing" Reference="pushing" Open="true"
                    OpenChanged="open => _pushing = open ? pushing : null" />
    }

    @if (_runFrom is { } runFrom)
    {
        @* Keyed on the reference so opening it for a second image rebuilds the form rather than
           leaving the first image's ports and environment behind. *@
        <RunDialog @key="runFrom" Image="runFrom" Open="true"
                   OpenChanged="open => _runFrom = open ? runFrom : null" />
    }

    @if (_pulling)
    {
        <PullDialog Open="true" OpenChanged="open => _pulling = open" OnPulled="LoadAsync" />
    }

    @if (_buildDialog)
    {
        <BuildDialog Open="true" OpenChanged="open => _buildDialog = open" OnBuilt="LoadAsync" />
    }
</EngineScope>

@code {
    static readonly string[] DanglingFilters = ["All images", "Tagged only", "Dangling only"];

    static readonly ContainerStatus DanglingStatus = new(StateTone.Warn, "○", "Dangling");

    IReadOnlyList<ImageSummary>? _images;
    string? _error;
    string? _notice;
    bool _noticeOk;
    string _search = "";
    int _danglingFilter;
    bool _pulling;

    /// <summary>The image reference the run dialog was opened for, or null when it is closed.</summary>
    /// <summary>
    /// What can be done with one image, most common first. Run leads because it is the point of
    /// having an image; a dangling one has no reference to run or push, so it gets neither.
    /// </summary>
    IReadOnlyList<RowAction> ActionsFor(ImageSummary image) =>
    [
        .. image.IsDangling ? [] : new[]
        {
            new RowAction("run", "Run…", IconRef.Play, $"Run a container from {image.DisplayName}"),
            new RowAction("tag", "Tag…", IconRef.Inspect, $"Add a tag to {image.DisplayName}"),
            new RowAction("push", "Push…", IconRef.Push, $"Push {image.DisplayName} to a registry"),
        },

        // Saving an untagged image works — the archive just has nothing to name it by, which is
        // why the file is named after its id.
        .. Archives
            ? new[]
            {
                new RowAction("save", "Save to a file…", IconRef.Save,
                    "Write this image to a tar archive", Disabled: _saving is not null),
            }
            : [],

        new RowAction("copy-id", "Copy ID", IconRef.Copy, $"Copy the ID of {image.DisplayName}"),
        new RowAction("remove", "Remove", IconRef.Trash, $"Remove {image.DisplayName}", Danger: true),
    ];

    ImageSummary? ById(string id) => Visible.FirstOrDefault(i => i.Id == id);

    Task RunRowActionAsync((string Row, string Action) chosen)
        => ById(chosen.Row) is { } image ? RunRowAsync(chosen.Action, image) : Task.CompletedTask;

    void OpenById(string id)
    {
        if (ById(id) is { } image) Nav.NavigateTo($"/images/{Uri.EscapeDataString(image.Id)}");
    }

    Task RunRowAsync(string id, ImageSummary image)
    {
        switch (id)
        {
            case "run":
                _runFrom = image.Tags[0].Display;
                break;

            case "tag":
                _tagging = image;
                break;

            case "push":
                _pushing = image.Tags[0].Display;
                break;

            case "save":
                return SaveAsync(image);

            case "copy-id":
                return Shell.WriteClipboardAsync(image.Id);

            case "remove":
                return RemoveAsync(image);
        }

        return Task.CompletedTask;
    }

    string? _runFrom;

    ImageSummary? _tagging;
    string? _pushing;
    bool _buildDialog;

    protected override Task OnInitializedAsync() => LoadAsync();

    List<ImageSummary> Visible
    {
        get
        {
            if (_images is null) return [];

            IEnumerable<ImageSummary> q = _images;

            q = _danglingFilter switch
            {
                1 => q.Where(i => !i.IsDangling),
                2 => q.Where(i => i.IsDangling),
                _ => q,
            };

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var needle = _search.Trim();
                q = q.Where(i =>
                    i.Tags.Any(t => t.Display.Contains(needle, StringComparison.OrdinalIgnoreCase))
                    || i.Id.Contains(needle, StringComparison.OrdinalIgnoreCase));
            }

            return [.. q];
        }
    }

    async Task LoadAsync()
    {
        _error = null;

        try
        {
            _images = await Engine.ListImagesAsync();
        }
        catch (Exception ex)
        {
            _images = null;
            _error = ex.Message;
        }
    }

    async Task RemoveAsync(ImageSummary image)
    {
        var inUse = image.IsInUse is true;

        var answer = await Shell.ConfirmDestructiveAsync(new DestructiveConfirm(
            $"Remove {image.DisplayName}?",
            inUse
                // Forcing here would break a running container, so Dray declines rather than
                // offering a button whose consequence is somewhere else entirely.
                ? "A container is still using this image. Remove the container first."
                : image.SizeReported
                    ? $"The image is deleted. Pulling it again downloads {Humanize.Bytes(image.SizeBytes)}."

                    // IsInUse is null on an engine that does not count containers per image, so
                    // Dray cannot promise nothing is using this. Saying so beats implying it is
                    // safe and letting the engine refuse a moment later.
                    : "The image is deleted. Pulling it again downloads it in full. This engine "
                      + "does not say whether a container is using it, so the removal may be refused.",
            "Remove"));

        if (answer != ConfirmResult.Confirm || inUse) return;

        if (await Engine.RemoveImageAsync(image.Id) is { } failure) Notify(failure, ok: false);
        else Notify($"Removed {image.DisplayName}.", ok: true);

        await LoadAsync();
    }

    void Notify(string message, bool ok)
    {
        _notice = message;
        _noticeOk = ok;
    }

    /// <summary>
    /// Whether saving and loading archives is offered at all.
    /// <para>
    /// Two conditions, and the second is about the head rather than the engine: an archive is a
    /// file on this machine, and choosing where it goes needs a file dialog. A browser has none,
    /// so the web head does not offer either — a Save button that silently does nothing is worse
    /// than no Save button.
    /// </para>
    /// </summary>
    bool Archives => (Engine.Selected?.Capabilities.SupportsImageArchive ?? false) && Caps.HasNativeDialogs;

    /// <summary>The image being written out, and how far it has got. Null when nothing is saving.</summary>
    string? _saving;
    long _savedBytes;

    /// <summary>
    /// Write one image to a file the user picks.
    /// <para>
    /// The archive is the engine's own format and the two engines disagree about it — Docker
    /// writes a docker-archive, Apple's writes an OCI layout — so the notice says which engine
    /// wrote it rather than implying it will load anywhere.
    /// </para>
    /// </summary>
    async Task SaveAsync(ImageSummary image)
    {
        if (_saving is not null) return;

        var reference = image.Tags.FirstOrDefault()?.Display ?? image.Id;

        var path = await Shell.SaveFileAsync(new FilePickerOptions(
            $"Save {image.DisplayName}",
            ImageArchive.SuggestedFileName(reference),
            ["tar"]));

        if (path is null) return;

        _saving = reference;
        _savedBytes = 0;

        var progress = new Progress<long>(bytes =>
        {
            _savedBytes = bytes;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            if (await Engine.SaveImageAsync(reference, path, progress) is { } error)
                Notify(error, ok: false);
            else
                Notify($"Saved {reference} to {System.IO.Path.GetFileName(path)} — {Humanize.Bytes(_savedBytes)}.", ok: true);
        }
        finally
        {
            _saving = null;
        }
    }

    /// <summary>Load images from an archive the user picks, and say what arrived.</summary>
    async Task LoadFromFileAsync()
    {
        var path = await Shell.PickFileAsync(new FilePickerOptions("Load images from an archive", Extensions: ["tar"]));
        if (path is null) return;

        var (loaded, error) = await Engine.LoadImageAsync(path);

        if (error is not null)
        {
            Notify(error, ok: false);
            return;
        }

        // An archive with no tags in it loads successfully and names nothing. Reporting that
        // honestly beats claiming an image by name that the engine never mentioned.
        Notify(
            loaded.Count switch
            {
                0 => "The archive loaded. The engine did not name anything in it — an archive with no tags reads this way.",
                1 => $"Loaded {loaded[0]}.",
                _ => $"Loaded {loaded.Count} images: {string.Join(", ", loaded)}.",
            },
            ok: true);

        await LoadAsync();
    }

    PageChrome Chrome => new(
        "Images",
        Subtitle: _images is null
            ? Engine.Selected?.Name
            : _images.All(i => i.SizeReported)
                ? $"{_images.Count} · {Humanize.Bytes(_images.Sum(i => i.UniqueBytes))} on {Engine.Selected?.Name}"

                // A total built from unmeasured images would be a number nobody could act on.
                : $"{_images.Count} on {Engine.Selected?.Name}",
        Search: new ChromeSearch("Filter images", _search),
        Actions:
        [
            ChromeAction.Primary("pull", "Pull…", IconRef.Pull),
            ChromeAction.Secondary("build", "Build…", IconRef.Build),
            .. Archives
                ? new[] { ChromeAction.Secondary("load", "Load from file…", IconRef.Files) }
                : [],
            ChromeAction.Secondary("refresh", "Refresh", IconRef.Refresh),
            ChromeAction.Destructive("prune", "Prune dangling", IconRef.Trash),
        ],
        Filters:
        [
            new ChromeFilter("dangling", "Show", [.. DanglingFilters.Select(f => new ChromeFilterOption(f))], _danglingFilter),
        ]);

    void HandleFilter((string FilterId, int Index) change)
    {
        if (change.FilterId == "dangling") _danglingFilter = change.Index;
    }

    async Task HandleAction(string id)
    {
        switch (id)
        {
            case "refresh":
                await LoadAsync();
                break;

            case "pull":
                _pulling = true;
                break;

            case "build":
                _buildDialog = true;
                break;

            case "load":
                await LoadFromFileAsync();
                break;

            case "prune":
                if (await Prune.RunAsync(PruneKind.Images) is { } outcome)
                {
                    Notify(outcome.Message, outcome.Ok);
                    await LoadAsync();
                }
                break;
        }
    }
}
