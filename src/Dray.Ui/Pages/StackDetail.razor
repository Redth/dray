@page "/stacks/{Name}"
@inject EngineManager Engine
@inject NavigationManager Nav
@inject ShellCapabilities Caps

<PageChromeScope Chrome="Chrome" OnAction="HandleAction" />

<EngineScope>
    <div class="detail">
        <div class="detail__head">
            <div class="detail__title">
                @if (!Caps.HasNativeToolbar)
                {
                    <BackButton To="/stacks" Label="All stacks" />
                }

                <h2>@StackName</h2>

                @if (Stack is { } header)
                {
                    <StatePill Status="header.Status" />
                }
            </div>

            <div class="detail__meta mono muted">
                @if (Stack is { } stack)
                {
                    <span>@stack.Services.Count service@(stack.Services.Count == 1 ? "" : "s")</span>
                    <span>@stack.RunningCount/@stack.ContainerCount running</span>

                    @if (stack.ConfigFiles.FirstOrDefault() is { } file)
                    {
                        <span title="@file">@file</span>
                    }
                }
            </div>
        </div>

        <div class="detail__card card">
            <div class="detail__tabs" role="tablist">
                @foreach (var tab in Tabs)
                {
                    <button type="button" role="tab" class="tab @(_tab == tab ? "is-active" : null)"
                            aria-selected="@((_tab == tab).ToString().ToLowerInvariant())"
                            @onclick="() => _tab = tab">@tab</button>
                }
            </div>

            <div class="detail__body">
                @if (Stack is not { } current)
                {
                    <div class="page">
                        <EmptyState Icon="IconRef.Stack" Title="That stack is not here"
                                    Body="It may have been brought down, or it belongs to a different host than the one selected." />
                    </div>
                }
                else if (_tab == "Services")
                {
                    <div class="page page--flush">
                        <table class="table">
                            <thead>
                                <tr><th>Service</th><th>State</th><th>Container</th><th>Image</th><th class="num">Uptime</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var service in current.Services)
                                {
                                    @foreach (var replica in service.Replicas)
                                    {
                                        <tr @key="replica.Id">
                                            <td>
                                                @service.Name
                                                @if (service.IsScaled)
                                                {
                                                    <span class="muted"> · @replica.Compose?.Replica</span>
                                                }
                                            </td>
                                            <td><StatePill Status="replica.Status" /></td>
                                            <td><a href="@($"/containers/{replica.ShortId}")">@replica.Name</a></td>
                                            <td class="muted">@Humanize.ImageName(replica.Image):@Humanize.ImageTag(replica.Image)</td>
                                            <td class="num muted">@Humanize.Since(replica.Since)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_file is { } file)
                {
                    @* The compose file and its .env, side by side, because the first is unreadable
                       without the second: nothing in the YAML refers to the .env, and every
                       ${VAR} in it resolves from there. *@
                    <div class="stack__compose">
                        <CodeEditor File="file" ReadOnly="@(!_writable)" OnSave="SaveAsync"
                                    OnClose="BackToServices" Annotations="_annotations" />

                        @if (WorkingDirectory is { Length: > 0 } directory)
                        {
                            <StackEnvPanel WorkingDirectory="@directory"
                                           Referenced="_referenced"
                                           VariablesChanged="OnVariablesChangedAsync" />
                        }
                    </div>
                }
                else
                {
                    <div class="page">
                        <EmptyState Icon="IconRef.Files" Title="@(_fileError is null ? "No compose file" : "Cannot read the compose file")"
                                    Body="@(_fileError ?? ComposeFileExplanation)" />
                    </div>
                }
            </div>
        </div>
    </div>
</EngineScope>

@code {
    static readonly string[] Tabs = ["Services", "Compose file"];

    const string ComposeFileExplanation =
        "The engine did not record which file this stack came from, or the file is on the machine "
        + "that ran compose rather than this one. Stacks started on a remote host name paths that "
        + "do not exist here.";

    [Parameter] public string Name { get; set; } = "";

    string StackName => Uri.UnescapeDataString(Name);

    StackSummary? Stack => Engine.Stacks.FirstOrDefault(s => s.Name == StackName);

    string _tab = "Services";
    FileContent? _file;
    string? _fileError;
    bool _writable;
    string? _readFor;

    IReadOnlyList<EditorAnnotation> _annotations = [];
    IReadOnlyCollection<string> _referenced = [];

    /// <summary>
    /// Where compose looks for <c>.env</c> — the directory it was run from, which it records on
    /// every container it creates. Falls back to the compose file's own folder, which is the same
    /// place in all but the unusual case of `-f` pointing elsewhere.
    /// </summary>
    string? WorkingDirectory
        => Stack?.WorkingDirectory is { Length: > 0 } recorded
            ? recorded
            : Stack?.ConfigFiles.FirstOrDefault() is { } path
                ? System.IO.Path.GetDirectoryName(path)
                : null;

    void BackToServices() => _tab = "Services";

    /// <summary>
    /// Re-annotate as the variables change — before saving, not after.
    /// <para>
    /// Seeing what a value will do is the reason to type it, so making the annotation wait for a
    /// save would put the feedback after the decision it was meant to inform.
    /// </para>
    /// </summary>
    Task OnVariablesChangedAsync(IReadOnlyList<EnvVar> variables)
    {
        Annotate(variables);
        return Task.CompletedTask;
    }

    void Annotate(IReadOnlyList<EnvVar> variables)
    {
        if (_file is not { } file)
        {
            _annotations = [];
            _referenced = [];
            return;
        }

        var values = variables.ToDictionary(v => v.Key, v => v.Value, StringComparer.Ordinal);
        var found = ComposeInterpolation.Find(file.Text, values);

        _referenced = [.. found.Select(s => s.Name).Distinct(StringComparer.Ordinal)];

        _annotations =
        [
            .. found.Select(s => new EditorAnnotation(
                s.Line,
                s.Column,
                s.Length,
                Hint(s),
                Kind(s.State),
                Hover(s))),
        ];
    }

    /// <summary>
    /// What is drawn beside the reference. Short, because it sits inside a line of YAML — the
    /// explanation goes in the hover.
    /// </summary>
    static string Hint(Substitution s) => s.State switch
    {
        SubstitutionState.Missing => "→ empty",
        SubstitutionState.Required => "→ will not run",
        _ when s.Resolved.Length == 0 => "→ empty",
        _ => "→ " + (s.Resolved.Length > 40 ? s.Resolved[..40] + "…" : s.Resolved),
    };

    static string Kind(SubstitutionState state) => state switch
    {
        SubstitutionState.Resolved => "ok",
        SubstitutionState.Defaulted => "default",
        SubstitutionState.Required => "required",
        _ => "missing",
    };

    static string? Hover(Substitution s) => s.State switch
    {
        // The quiet failure, stated plainly. Compose does not error on this — it substitutes an
        // empty string and carries on, so an image tag becomes `myapp:` and fails much later.
        SubstitutionState.Missing =>
            $"**{s.Name}** is not set.\n\nCompose substitutes an empty string and carries on, so "
            + "this line becomes whatever it reads without the variable. Add it on the right.",

        SubstitutionState.Required =>
            $"**{s.Name}** is not set, and this reference requires it.\n\nCompose refuses to run "
            + "the stack until it has a value.",

        SubstitutionState.Defaulted =>
            $"**{s.Name}** is not set, so the default in this reference is used.",

        _ => null,
    };

    protected override void OnParametersSet()
    {
        if (_readFor == StackName) return;

        _readFor = StackName;
        _file = null;
        _fileError = null;

        LoadComposeFile();
    }

    /// <summary>
    /// Read the compose file off this machine.
    /// <para>
    /// The path comes from a label the engine wrote when the stack was created, which means it is a
    /// path on whichever machine ran <c>compose up</c>. For a local engine that is here; for a
    /// remote one it is not, and the file simply will not exist — which is said plainly rather than
    /// shown as an error.
    /// </para>
    /// </summary>
    void LoadComposeFile()
    {
        if (Stack?.ConfigFiles.FirstOrDefault() is not { } path) return;

        try
        {
            if (!System.IO.File.Exists(path)) return;

            _file = FileContent.Decode(path, System.IO.File.ReadAllBytes(path));

            // Annotated once on load with no variables, so a file full of ${VAR} shows what it
            // would do right now rather than nothing until the panel reports in.
            Annotate([]);

            // Editing is offered only where it would actually take effect. A read-only file, or one
            // Dray cannot write, opens for reading rather than presenting a Save that fails.
            var info = new System.IO.FileInfo(path);
            _writable = !info.IsReadOnly;
        }
        catch (Exception ex)
        {
            _fileError = ex.Message;
        }
    }

    /// <summary>
    /// Write the file back.
    /// <para>
    /// Saving does not apply anything — compose reads the file when it next runs. Saying so is the
    /// difference between a user thinking their change is live and finding out later.
    /// </para>
    /// </summary>
    Task<string?> SaveAsync(string path, byte[] content)
    {
        try
        {
            System.IO.File.WriteAllBytes(path, content);
            return Task.FromResult<string?>(null);
        }
        catch (Exception ex)
        {
            return Task.FromResult<string?>(ex.Message);
        }
    }

    PageChrome Chrome => new(
        StackName,
        Subtitle: Engine.Selected?.Name,
        Actions: [ChromeAction.Secondary("logs", "Logs", IconRef.Logs)],
        Back: new ChromeBack("back", "All stacks"));

    void HandleAction(string id)
    {
        switch (id)
        {
            case "back":
                Nav.NavigateTo("/stacks");
                break;

            case "logs":
                Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(StackName)}/logs");
                break;
        }
    }
}
