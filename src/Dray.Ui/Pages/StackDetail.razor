@page "/stacks/{Name}"
@inject EngineManager Engine
@inject NavigationManager Nav
@inject ShellCapabilities Caps
@inject StackActionService Actions
@inject StackOperations Operations
@implements IDisposable

<PageChromeScope Chrome="Chrome" OnAction="HandleAction" />

<EngineScope>
    <div class="detail">
        <div class="detail__head">
            <div class="detail__title">
                @if (!Caps.HasNativeToolbar)
                {
                    <BackButton To="/stacks" Label="All stacks" />
                }

                <h2>@StackName</h2>

                @if (Stack is { } header)
                {
                    <StatePill Status="header.Status" />
                }

                @if (!Caps.HasNativeToolbar && Stack is { } acting)
                {
                    @* On a head with a native toolbar these are toolbar items (Chrome, below); here
                       they are the page's own, the way the container page does it. *@
                    <div class="detail__actions">
                        <RowActions Actions="Actions.ActionsFor(acting)" Visible="3"
                                    MenuLabel="@($"More commands for {acting.Name}")"
                                    OnAction="id => RunAsync(acting, id)" />
                    </div>
                }
            </div>

            <div class="detail__meta mono muted">
                @if (Stack is { } stack)
                {
                    <span>@stack.Services.Count service@(stack.Services.Count == 1 ? "" : "s")</span>
                    @if (!stack.IsDown)
                    {
                        <span>@stack.RunningCount/@stack.ContainerCount running</span>
                    }

                    @if (stack.ConfigFiles.FirstOrDefault() is { } file)
                    {
                        <span title="@file">@file</span>
                    }
                }
            </div>
        </div>

        <div class="detail__card card">
            <div class="detail__tabs" role="tablist">
                @foreach (var tab in Tabs)
                {
                    <button type="button" role="tab" class="tab @(_tab == tab ? "is-active" : null)"
                            aria-selected="@((_tab == tab).ToString().ToLowerInvariant())"
                            @onclick="() => _tab = tab">@tab</button>
                }
            </div>

            @if (_notice is { } topNotice && _tab != "Services")
            {
                <div class="banner @(_noticeOk ? "banner--ok" : null)" role="status">
                    <Icon Name="@(_noticeOk ? IconRef.Check : IconRef.Warning)" Size="IconSize.Sm" />
                    <span>@topNotice</span>
                    <Button Label="Dismiss" Icon="IconRef.Close" IconOnly="true"
                            Variant="ButtonVariant.Ghost" OnClick="() => _notice = null" />
                </div>
            }

            <OperationLog Stack="@StackName" />

            <div class="detail__body">
                @if (Stack is not { } current)
                {
                    <div class="page">
                        <EmptyState Icon="IconRef.Stack" Title="That stack is not here"
                                    Body="It belongs to a different host than the one selected, or Dray was told to forget it and nothing of it is running." />
                    </div>
                }
                else if (_tab == "Services")
                {
                    <div class="page page--flush">
                        @if (_notice is { } notice)
                        {
                            <div class="banner @(_noticeOk ? "banner--ok" : null)" role="status">
                                <Icon Name="@(_noticeOk ? IconRef.Check : IconRef.Warning)" Size="IconSize.Sm" />
                                <span>@notice</span>
                                <Button Label="Dismiss" Icon="IconRef.Close" IconOnly="true"
                                        Variant="ButtonVariant.Ghost" OnClick="() => _notice = null" />
                            </div>
                        }

                        @if (DriftSummary is { } drifted)
                        {
                            <div class="note stack__drift" role="status">
                                <Icon Name="IconRef.Info" Size="IconSize.Sm" />
                                <span>@drifted</span>
                            </div>
                        }

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Service</th><th>State</th><th>Container</th><th>Image</th>
                                    <th class="num">Uptime</th><th class="num">Replicas</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var service in current.Services)
                                {
                                    var captured = service;

                                    @if (service.Replicas.Count == 0)
                                    {
                                        @* Declared in the file, no container on this host: never
                                           started, behind a profile, or scaled to zero. Listed so
                                           the stack on screen is the stack in the file. *@
                                        <tr @key="service.Name">
                                            <td>
                                                @service.Name
                                                @if (DriftPill(service.Name) is { } drift)
                                                {
                                                    <StatePill Status="drift" />
                                                }
                                            </td>
                                            <td><StatePill Status="service.Status" /></td>
                                            <td class="muted">No container</td>
                                            <td class="muted">—</td>
                                            <td class="num muted">—</td>
                                            <td class="num"></td>
                                            <td class="cell-actions">
                                                <RowActions Actions="Actions.ServiceActionsFor(current, captured)" Visible="2"
                                                            MenuLabel="@($"More for {service.Name}")"
                                                            OnAction="id => RunService(current, captured, id, null)" />
                                            </td>
                                        </tr>
                                    }

                                    @foreach (var (replica, index) in service.Replicas.Select((r, i) => (r, i)))
                                    {
                                        var container = replica;

                                        <tr @key="replica.Id">
                                            <td>
                                                @service.Name
                                                @if (service.IsScaled)
                                                {
                                                    <span class="muted"> · @replica.Compose?.Replica</span>
                                                }

                                                @if (index == 0 && DriftPill(service.Name) is { } drift)
                                                {
                                                    <StatePill Status="drift" />
                                                }
                                            </td>
                                            <td><StatePill Status="replica.Status" /></td>
                                            <td><a href="@($"/containers/{replica.ShortId}")">@replica.Name</a></td>
                                            <td class="muted">@Humanize.ImageName(replica.Image):@Humanize.ImageTag(replica.Image)</td>
                                            <td class="num muted">@Humanize.Since(replica.Since)</td>

                                            @* The control belongs to the service, not to any one of
                                               its containers, so it sits on the first replica's row
                                               and the rest leave the cell empty rather than
                                               repeating a control that would fight itself. *@
                                            @if (index == 0)
                                            {
                                                <td class="num">
                                                    <ScaleControl Service="captured" Busy="@(_scaling == captured.Name)"
                                                                  OnScale="n => ScaleAsync(captured, n)" />
                                                </td>
                                                <td class="cell-actions">
                                                    @* The service's actions, with Shell aimed at this
                                                       replica; later rows get a Shell of their own —
                                                       the replica picker is the table itself. *@
                                                    <RowActions Actions="Actions.ServiceActionsFor(current, captured)" Visible="2"
                                                                MenuLabel="@($"More for {service.Name}")"
                                                                OnAction="id => RunService(current, captured, id, container)" />
                                                </td>
                                            }
                                            else
                                            {
                                                <td></td>
                                                <td class="cell-actions">
                                                    @if (container.State == DockerState.Running && Engine.Selected?.Capabilities.SupportsShell != false)
                                                    {
                                                        <Button Label="@($"Shell in {container.Name}")" Icon="IconRef.Terminal" IconOnly="true"
                                                                Variant="ButtonVariant.Ghost"
                                                                OnClick="@(() => Nav.NavigateTo($"/containers/{container.ShortId}?tab=Terminal"))" />
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_tab == "Dependencies")
                {
                    @* Drawn from the file rather than the engine: compose reads depends_on to
                       decide start order and keeps no record of it afterwards. *@
                    <DependencyGraph Services="current.Services" Yaml="@(_file?.Text)" />
                }
                else if (_file is not null)
                {
                    <StackCompose Stack="current" WorkingDirectory="@WorkingDirectory"
                                  OnClose="BackToServices" OnSaved="OnComposeSavedAsync" />
                }
                else
                {
                    <div class="page">
                        <EmptyState Icon="IconRef.Files" Title="@(_fileError is null ? "No compose file" : "Cannot read the compose file")"
                                    Body="@(_fileError ?? ComposeFileExplanation)" />
                    </div>
                }
            </div>
        </div>
    </div>
</EngineScope>

@code {
    static readonly string[] Tabs = ["Services", "Dependencies", "Compose file"];

    const string ComposeFileExplanation =
        "The engine did not record which file this stack came from, or the file is on the machine "
        + "that ran compose rather than this one. Stacks started on a remote host name paths that "
        + "do not exist here.";

    [Parameter] public string Name { get; set; } = "";

    /// <summary><c>?tab=compose</c> opens on the files — where a refused Deploy sends you.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }

    /// <summary>What Deploy would change per service, or null when unknown. See <see cref="StackDrift"/>.</summary>
    IReadOnlyDictionary<string, ServiceDrift>? _drift;
    CancellationTokenSource? _driftCts;

    string StackName => Uri.UnescapeDataString(Name);

    StackSummary? Stack => Engine.Stacks.FirstOrDefault(s => s.Name == StackName);

    string _tab = "Services";

    /// <summary>
    /// The first compose file, for the dependency graph. The Compose tab reads every file itself;
    /// this is re-read when it saves, so the graph follows an edit to <c>depends_on</c>.
    /// </summary>
    FileContent? _file;
    string? _fileError;
    string? _readFor;

    /// <summary>
    /// Where compose looks for <c>.env</c> — the directory it was run from, which it records on
    /// every container it creates. Falls back to the compose file's own folder, which is the same
    /// place in all but the unusual case of `-f` pointing elsewhere.
    /// </summary>
    string? WorkingDirectory
        => Stack?.WorkingDirectory is { Length: > 0 } recorded
            ? recorded
            : Stack?.ConfigFiles.FirstOrDefault() is { } path
                ? System.IO.Path.GetDirectoryName(path)
                : null;

    void BackToServices() => _tab = "Services";

    string? _scaling;
    string? _notice;
    bool _noticeOk;

    /// <summary>
    /// Ask compose for a different number of containers for one service.
    /// <para>
    /// <c>up --scale</c> rather than the deprecated <c>compose scale</c>, and <c>--no-recreate</c>
    /// so the containers already running are left alone: without it compose recreates the whole
    /// service, which restarts things the user did not ask to restart just to add one replica.
    /// </para>
    /// <para>
    /// Nothing is written to the store. The new containers arrive on the event stream like any
    /// others, which is also what makes the count on screen correct a moment later without this
    /// method knowing anything about it.
    /// </para>
    /// </summary>
    async Task ScaleAsync(StackService service, int replicas)
    {
        if (Stack is not { } stack || _scaling is not null) return;

        _scaling = service.Name;
        _notice = null;

        try
        {
            int? exitCode = null;
            string? lastError = null;

            await foreach (var line in Engine.RunComposeAsync(
                stack, ["up", "-d", "--no-recreate", "--scale", $"{service.Name}={replicas}"]))
            {
                if (line.IsExit) exitCode = line.ExitCode;
                else if (line.IsError && line.Text.Trim() is { Length: > 0 } text) lastError = text;
            }

            // Success is a reported zero and nothing else. Compose writes its progress to stderr
            // on a run that worked, so stderr alone says nothing; and a run that never reported how
            // it ended is not one Dray can call done.
            if (exitCode == 0)
            {
                _notice = replicas == 1
                    ? $"{service.Name} is back to a single container."
                    : $"{service.Name} scaled to {replicas} containers.";

                _noticeOk = true;
            }
            else
            {
                _notice = lastError ?? (exitCode is { } code
                    ? $"Compose exited with {code} scaling {service.Name}."
                    : $"Compose did not say whether {service.Name} scaled.");

                _noticeOk = false;
            }
        }
        catch (Exception ex)
        {
            _notice = ex.Message;
            _noticeOk = false;
        }
        finally
        {
            _scaling = null;
        }
    }

    string? _tabFor;

    protected override void OnParametersSet()
    {
        // Followed separately from the stack: a refused Deploy sends you here from this very page,
        // and the same component instance gets only the query changed.
        if (InitialTab != _tabFor)
        {
            _tabFor = InitialTab;
            if (InitialTab is "compose") _tab = "Compose file";
        }

        if (_readFor == StackName) return;

        _readFor = StackName;
        _file = null;
        _fileError = null;

        LoadComposeFile();
        _ = RefreshDriftAsync();
    }

    /// <summary>Saving changed the file: re-read it for the graph, and ask compose what it now differs by.</summary>
    async Task OnComposeSavedAsync()
    {
        LoadComposeFile();
        await RefreshDriftAsync();
    }

    async Task RefreshDriftAsync()
    {
        _driftCts?.Cancel();
        var cts = _driftCts = new CancellationTokenSource();

        if (Stack is not { } stack || stack.Provenance == StackProvenance.Observed)
        {
            _drift = null;
            return;
        }

        try
        {
            var drift = await Engine.DriftAsync(stack, cts.Token);
            if (cts.IsCancellationRequested) return;

            _drift = drift;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>The services Deploy would touch, for the banner over the services.</summary>
    string? DriftSummary
    {
        get
        {
            if (_drift is not { } drift || Stack is not { IsDown: false }) return null;

            var changed = drift.Where(d => d.Value == ServiceDrift.Changed).Select(d => d.Key).Order().ToList();
            var created = drift.Where(d => d.Value == ServiceDrift.NotCreated).Select(d => d.Key).Order().ToList();
            var removed = drift.Where(d => d.Value == ServiceDrift.Removed).Select(d => d.Key).Order().ToList();

            var parts = new List<string>();
            if (changed.Count > 0) parts.Add($"recreate {string.Join(", ", changed)}");
            if (created.Count > 0) parts.Add($"create {string.Join(", ", created)}");
            if (removed.Count > 0) parts.Add($"remove {string.Join(", ", removed)}");

            return parts.Count == 0 ? null : $"The files have changed since this stack was deployed. Deploy will {string.Join("; ", parts)}.";
        }
    }

    /// <summary>A service's drift, as a pill — glyph, word and tint — or null when there is nothing to say.</summary>
    ContainerStatus? DriftPill(string service) => _drift?.GetValueOrDefault(service) switch
    {
        ServiceDrift.Changed => new ContainerStatus(StateTone.Warn, "✎", "Edited", "not deployed"),
        ServiceDrift.NotCreated when Stack is { IsDown: false } => new ContainerStatus(StateTone.Neutral, "+", "Not created"),
        ServiceDrift.Removed => new ContainerStatus(StateTone.Neutral, "−", "Not in the file"),
        _ => null,
    };

    /// <summary>
    /// Read the compose file off this machine.
    /// <para>
    /// The path comes from a label the engine wrote when the stack was created, which means it is a
    /// path on whichever machine ran <c>compose up</c>. For a local engine that is here; for a
    /// remote one it is not, and the file simply will not exist — which is said plainly rather than
    /// shown as an error.
    /// </para>
    /// </summary>
    void LoadComposeFile()
    {
        _file = null;
        _fileError = null;

        if (Stack?.ConfigFiles.FirstOrDefault() is not { } path) return;

        try
        {
            if (!System.IO.File.Exists(path)) return;

            _file = FileContent.Decode(path, System.IO.File.ReadAllBytes(path));
        }
        catch (Exception ex)
        {
            _fileError = ex.Message;
        }
    }

    protected override void OnInitialized() => Operations.Changed += OnOperationChanged;

    void OnOperationChanged(StackOperation operation)
    {
        // Start and end change which actions are enabled; the lines are the log's to draw.
        if (operation.Stack != StackName) return;

        // A finished deploy is the moment the files and the containers agree again.
        if (!operation.IsRunning) _ = RefreshDriftAsync();

        if (operation.Lines.Count <= 1 || !operation.IsRunning) InvokeAsync(StateHasChanged);
    }

    async Task RunAsync(StackSummary stack, string action)
    {
        var notice = await Actions.RunAsync(stack, action);

        // A deleted or forgotten stack has nothing left to show here.
        if (action == "delete" && notice is null) Nav.NavigateTo("/stacks");

        if (notice is not null)
        {
            _notice = notice;
            _noticeOk = action == "forget";
        }
    }

    void RunService(StackSummary stack, StackService service, string action, ContainerSummary? replica)
    {
        switch (action)
        {
            case "logs":
                if (service.Replicas.Count == 1) Nav.NavigateTo($"/containers/{service.Replicas[0].ShortId}");
                else Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(stack.Name)}/logs");
                break;

            case "shell":
                var target = replica is { State: DockerState.Running } ? replica : service.Replicas.FirstOrDefault(r => r.State == DockerState.Running);
                if (target is not null) Nav.NavigateTo($"/containers/{target.ShortId}?tab=Terminal");
                break;

            default:
                if (Actions.RunService(stack, service, action) is { } notice)
                {
                    _notice = notice;
                    _noticeOk = false;
                }

                break;
        }
    }

    /// <summary>
    /// On a native toolbar the stack's actions are toolbar items, in the order their state invites:
    /// the first is the page's one primary, a destructive one is never primary, and Logs follows.
    /// </summary>
    PageChrome Chrome
    {
        get
        {
            var actions = new List<ChromeAction>();

            if (Caps.HasNativeToolbar && Stack is { } stack)
            {
                var offered = Actions.ActionsFor(stack).Where(a => !a.Disabled).ToList();

                for (var i = 0; i < offered.Count; i++)
                {
                    var a = offered[i];
                    var label = a.Label.Replace(" " + stack.Name, "", StringComparison.Ordinal);

                    actions.Add(a.Danger
                        ? ChromeAction.Destructive(a.Id, label, a.Icon)
                        : i == 0 ? ChromeAction.Primary(a.Id, label, a.Icon) : ChromeAction.Secondary(a.Id, label, a.Icon));
                }
            }

            actions.Add(ChromeAction.Secondary("logs", "Logs", IconRef.Logs));

            return new(StackName, Subtitle: Engine.Selected?.Name, Actions: actions, Back: new ChromeBack("back", "All stacks"));
        }
    }

    async Task HandleAction(string id)
    {
        switch (id)
        {
            case "back":
                Nav.NavigateTo("/stacks");
                break;

            case "logs":
                Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(StackName)}/logs");
                break;

            default:
                if (Stack is { } stack) await RunAsync(stack, id);
                break;
        }
    }

    public void Dispose()
    {
        Operations.Changed -= OnOperationChanged;
        _driftCts?.Cancel();
    }
}
