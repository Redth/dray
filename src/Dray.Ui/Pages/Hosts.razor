@page "/hosts"
@inject EngineManager Engine
@inject IShellBridge Shell

<EngineScope>
    @* Inside the scope: the subtitle counts hosts, and a value computed above the tag is never
       recomputed when one is added or removed. *@
    <PageChromeScope Chrome="Chrome" OnAction="HandleAction" />

    <div class="page">
        @if (Engine.HasNoHosts)
        {
            <NoEngine OnRetry="Rediscover" OnAdd="() => OpenAdd()" />
        }
        else
        {
            @* A list and the one host it has selected, side by side when there is room and stacked
               when there is not. Sized by the content area rather than the window, so a wide
               window with a wide sidebar stacks too — the failure the old six-column table had. *@
            <div class="hosts">
                <div class="hosts__grid">
                    <nav class="card hostlist" aria-label="Engines">
                        <div class="hostlist__head">
                            <span class="hostlist__title">Engines</span>
                            <span class="hostlist__count">@Engine.Hosts.Count</span>
                        </div>

                        <ul class="hostlist__items">
                            @foreach (var host in Engine.Hosts)
                            {
                                var selected = Engine.Selected?.Id == host.Id;

                                <li @key="host.Id">
                                    @* The picker is the switch: choosing a host here is choosing
                                       the engine every page shows, as it is in the sidebar. *@
                                    <button type="button"
                                            class="hostitem @(selected ? "is-selected" : null) @(host.IsStale ? "is-stale" : null)"
                                            aria-current="@(selected ? "true" : null)"
                                            title="@host.Endpoint.Display"
                                            @onclick="() => Select(host)">
                                        <EngineGlyph Icon="HostFacts.Icon(host)" Active="selected" />
                                        <span class="hostitem__text">
                                            <span class="hostitem__name">@host.Name</span>
                                            <span class="hostitem__sub">@HostFacts.Summary(host)</span>
                                        </span>
                                        <HostState Host="host" />
                                    </button>
                                </li>
                            }
                        </ul>

                        <button type="button" class="hostlist__add" @onclick="() => OpenAdd()">
                            <Icon Name="IconRef.Plus" Size="IconSize.Sm" />
                            <span>Add a host…</span>
                        </button>
                    </nav>

                    <div class="hosts__detail">
                        @* The case discovery cannot cover: a Mac that could run Apple's engine and
                           has not got it. Gated on the machine actually being able to run it —
                           pointing someone at a download that will not start is worse than saying
                           nothing. *@
                        @if (AppleAvailability == AppleEngineAvailability.Available)
                        {
                            <div class="hosts__suggest">
                                <EngineGlyph Icon="IconRef.Container" />
                                <p class="hosts__suggesttext">@AppleEngine.Explain(AppleAvailability)</p>
                                <Button Label="Set it up…" Variant="ButtonVariant.Secondary"
                                        OnClick="@(() => OpenAdd("apple-container"))" />
                            </div>
                        }

                        @if (Engine.Selected is { } current)
                        {
                            <HostDetail Host="current" />
                        }
                    </div>
                </div>
            </div>
        }

        @* Outside the branch above, and deliberately: a machine with nothing to connect to is the
           one that most needs this, and it is the branch where Dray otherwise has nothing to say
           beyond what it looked for. It hides itself once both engines answer. *@
        @if (OperatingSystem.IsWindows())
        {
            <WindowsSetup />
        }
    </div>
</EngineScope>

@code {
    PageChrome Chrome => new(
        "Hosts",
        Subtitle: Engine.HasNoHosts ? null : $"{Engine.Hosts.Count} known",
        Actions:
        [
            ChromeAction.Primary("add", "Add host", IconRef.Plus),
            ChromeAction.Secondary("refresh", "Look again", IconRef.Refresh),
        ]);

    /// <summary>
    /// Whether Apple's engine is worth mentioning. Discovery finds it on PATH, so both ways of
    /// installing it are already handled — Apple's signed package puts it in /usr/local/bin and
    /// Homebrew's formula puts a wrapper in /opt/homebrew/bin. This is the case discovery cannot
    /// cover: a machine that could run it and has not got it.
    /// </summary>
    AppleEngineAvailability AppleAvailability => AppleEngine.Check(
        installed: Engine.Hosts.Any(h => h.Origin == HostOrigin.AppleContainer),
        isMacOS: OperatingSystem.IsMacOS(),
        isAppleSilicon: System.Runtime.InteropServices.RuntimeInformation.OSArchitecture
            is System.Runtime.InteropServices.Architecture.Arm64,
        macOSMajor: Environment.OSVersion.Version.Major);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Checked when the page opens rather than on a timer: probing a remote host costs a
        // connection, and doing it for hosts nobody is looking at is the polling this design avoids.
        await Engine.ProbeOthersAsync();
    }

    /// <summary>
    /// Through the shell, so it is a native sheet on macOS and a &lt;dialog&gt; in a browser. The
    /// flow selects the host it adds, and the page follows the engine, so there is nothing to read
    /// back from it.
    /// </summary>
    Task OpenAdd(string? guide = null) => Shell.ShowDialogAsync(AddHostDialog.Request(guide));

    async Task Select(DockerHost host) => await Engine.SelectAsync(host.Id);

    async Task Rediscover() => await Engine.InitializeAsync();

    async Task HandleAction(string id)
    {
        switch (id)
        {
            case "add":
                await OpenAdd();
                break;

            case "refresh":
                await Engine.InitializeAsync();
                await Engine.ProbeOthersAsync();
                break;
        }
    }
}
