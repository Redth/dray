@page "/stacks"
@implements IDisposable
@inject EngineManager Engine
@inject IShellBridge Shell
@inject NavigationManager Nav

<EngineScope>
    @* Declared inside EngineScope, not above it: this page's chrome reports a count that comes
       from the store, and EngineScope re-renders only its own child content. Left outside, the
       toolbar would keep the subtitle it had when the page opened. *@
    <PageChromeScope Chrome="Chrome" OnAction="HandleAction" OnSearch="s => _search = s" />

    <div class="page page--flush">
        @if (_notice is { } notice)
        {
            <div class="banner @(_noticeOk ? "banner--ok" : null)" role="status">
                <Icon Name="@(_noticeOk ? IconRef.Check : IconRef.Warning)" Size="IconSize.Sm" />
                <span>@notice</span>
                <Button Label="Dismiss" Icon="IconRef.Close" IconOnly="true" Variant="ButtonVariant.Ghost"
                        OnClick="() => _notice = null" />
            </div>
        }

        @if (Engine.HasNoHosts)
        {
            <NoEngine />
        }
        else if (Visible.Count == 0 && _search.Length == 0 && Engine.Selected is { Capabilities.SupportsCompose: false })
        {
            @* Only when the list is also empty: a Docker host without the compose CLI still has
               stacks worth reading, because Dray discovers them from container labels rather than
               from compose. This branch is for an engine compose does not target at all. *@
            <NotOnThisEngine Feature="stacks" Icon="IconRef.Stack"
                             Instead="Compose does not target this engine, so nothing here carries the labels a stack is made of. Switch to a Docker-compatible host on the Hosts page." />
        }
        else if (Visible.Count == 0)
        {
            <EmptyState Icon="IconRef.Stack"
                        Title="@(_search.Length > 0 ? "No stacks match" : "No stacks")"
                        Body="@(_search.Length > 0
                            ? "Nothing here matches the current search."
                            : "A stack appears here as soon as one is running — including one brought up from a terminal. Dray reads the labels compose puts on containers, so nothing has to be registered first.")" />
        }
        else
        {
            <div class="stacks">
                @foreach (var stack in Visible)
                {
                    var open = IsOpen(stack);
                    var services = $"services-{stack.Name}";

                    <section class="stacks__card card" @key="stack.Name">
                        <div class="panel__head stacks__head">
                            <button type="button" class="stacks__toggle" aria-expanded="@open"
                                    aria-controls="@services"
                                    aria-label="@($"{(open ? "Hide" : "Show")} the services in {stack.Name}")"
                                    @onclick="() => Toggle(stack)">
                                <Icon Name="IconRef.ChevronRight" Size="IconSize.Sm" />
                            </button>

                            <Icon Name="IconRef.Stack" Size="IconSize.Sm" Class="stacks__glyph" />

                            <h3 class="panel__title">
                                <a href="@($"/stacks/{Uri.EscapeDataString(stack.Name)}")">@stack.Name</a>
                            </h3>
                            <StatePill Status="stack.Status" />

                            <span class="muted stacks__count">
                                @stack.Services.Count service@(stack.Services.Count == 1 ? "" : "s") ·
                                @stack.RunningCount/@stack.ContainerCount running
                            </span>

                            @if (_composeMissing)
                            {
                                @* Compose is a separate CLI, and a stack can be running that Dray
                                   cannot drive. Saying so beats buttons that fail on click. *@
                                <span class="muted stacks__note" title="Install Docker Compose to control stacks from Dray">
                                    <Icon Name="IconRef.Warning" Size="IconSize.Sm" />
                                    compose not installed
                                </span>
                            }
                            else
                            {
                                @* Up on the card, the rest behind a ⋯. Up is what a stack card is
                                   for; restarting, pulling and bringing one down are deliberate.
                                   The stack's name goes in each accessible label rather than on
                                   screen: with a card per stack, four controls reading "Up" are
                                   only distinguishable by which card they are in. *@
                                <RowActions Actions="CommandsFor(stack)" Visible="1"
                                            MenuLabel="@($"More commands for {stack.Name}")"
                                            OnAction="id => RunAsync(stack, id, LabelFor(id))" />
                            }
                        </div>

                        @* The wrapper is always here so the disclosure button always has something
                           to point aria-controls at; the table itself is only built when it is
                           being shown. *@
                        <div id="@services" class="stacks__services">
                            @if (open)
                            {
                        @* Flush: this is the card's content, and a card inside a card is always
                           wrong. Columns from StackServiceGrid — narrower than the containers
                           list, because the stack's own name and state are already above it. *@
                        <DataTable TRow="StackService"
                                   Flush="true"
                                   Columns="StackServiceGrid.Columns()"
                                   Rows="stack.Services"
                                   Values="s => StackServiceGrid.Row(s)"
                                   Key="s => s.Name"
                                   ActionsFor="_ => ServiceActions"
                                   OnAction="a => OpenLogsByName(stack, a.Row)" />
                            }
                        </div>
                    </section>
                }
            </div>
        }

        @if (_output.Count > 0)
        {
            <section class="stacks__output card">
                <div class="panel__head">
                    <h3 class="panel__title">
                        @(_watching is { } watched ? $"Watching {watched}" : _running ?? "Finished")
                    </h3>
                    <span class="stacks__spacer"></span>

                    @if (_watching is { } stopping)
                    {
                        <Button Label="Stop watching" Icon="IconRef.Stop" Variant="ButtonVariant.Ghost"
                                OnClick="() => _watchCts?.Cancel()" />
                    }
                    else
                    {
                        <Button Label="Clear" Icon="IconRef.Close" Variant="ButtonVariant.Ghost"
                                Disabled="@(_running is not null)" OnClick="() => _output.Clear()" />
                    }
                </div>

                <pre class="stacks__log mono"><code>@string.Join('\n', _output)</code></pre>
            </section>
        }
    </div>
</EngineScope>

@code {
    /// <summary>
    /// The compose commands worth a button. Deliberately not every subcommand: <c>up</c> and
    /// <c>down</c> are what people do, and a wall of eight buttons makes the two that matter harder
    /// to find.
    /// </summary>
    static readonly (string Id, string Label, IconRef Icon, bool Danger, string Hint)[] StackCommands =
    [
        ("up", "Up", IconRef.Play, false, "Up — start the stack, creating anything that is missing"),
        ("restart", "Restart", IconRef.Restart, false, "Restart every container in the stack"),
        ("pull", "Pull", IconRef.Pull, false, "Pull newer images for the stack"),
        ("down", "Down", IconRef.Stop, true, "Down — stop and remove the stack's containers"),
    ];

    string _search = "";
    string? _notice;

    /// <summary>The compose that was found, or null. Its version decides whether watch is offered.</summary>
    ComposeCommand? _compose;

    /// <summary>The stack being watched, and the token that stops it. Watch does not end on its own.</summary>
    string? _watching;
    CancellationTokenSource? _watchCts;

    /// <summary>
    /// Which stacks are showing their services.
    /// <para>
    /// Closed to begin with: on a machine with a dozen stacks the page was one long table and the
    /// stack names — the thing being looked for — were the smallest part of it. A stack that is not
    /// fully running opens itself, because then the services are the reason the page was opened.
    /// </para>
    /// <para>
    /// Held per name rather than per stack, so a stack that restarts keeps its disclosure.
    /// </para>
    /// </summary>
    readonly Dictionary<string, bool> _open = [];
    bool _noticeOk;
    bool _composeMissing;

    /// <summary>The command in flight, as a label. Null when nothing is running.</summary>
    string? _running;

    readonly List<string> _output = [];
    CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        Engine.Changed += OnEngineChanged;

        // Probed once. A machine either has compose or it does not, and asking again per render
        // would shell out on every keystroke in the filter.
        _compose = await Engine.DetectComposeAsync();
        _composeMissing = _compose is null;
    }

    void OnEngineChanged() => InvokeAsync(StateHasChanged);

    IReadOnlyList<StackSummary> Visible
    {
        get
        {
            var stacks = Engine.Stacks;
            if (string.IsNullOrWhiteSpace(_search)) return stacks;

            var needle = _search.Trim();

            return
            [
                .. stacks.Where(s =>
                    s.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || s.Services.Any(v => v.Name.Contains(needle, StringComparison.OrdinalIgnoreCase))),
            ];
        }
    }

    IReadOnlyList<RowAction> CommandsFor(StackSummary stack)
    {
        var commands = StackCommands.Select(c => new RowAction(
            c.Id,
            $"{c.Label} {stack.Name}",
            c.Icon,
            c.Hint,
            c.Danger,
            Disabled: _running is not null || _watching is not null)).ToList();

        // Watch is offered only where it would do something: compose has to be new enough to have
        // the subcommand, and the file has to say what to watch. Without both, `compose watch`
        // exits with a message, which is a worse answer than not offering it.
        if (WatchedServices(stack) is { Count: > 0 } services)
        {
            var on = _watching == stack.Name;

            commands.Add(new RowAction(
                "watch",
                on ? $"Stop watching {stack.Name}" : $"Watch {stack.Name}",
                on ? IconRef.Stop : IconRef.Refresh,
                on
                    ? "Stop rebuilding and syncing on file changes"
                    : $"Rebuild and sync {string.Join(", ", services)} as their files change",
                Disabled: _running is not null && !on));
        }

        return commands;
    }

    /// <summary>
    /// The services this stack's file declares something to watch for, or nothing.
    /// <para>
    /// Read from the file on every render, which is cheap and always current — the alternative is
    /// caching it and offering a stale answer after someone edits the compose file in the tab next
    /// to this one.
    /// </para>
    /// </summary>
    IReadOnlyList<string> WatchedServices(StackSummary stack)
    {
        if (!ComposeWatch.IsSupported(_compose?.Version)) return [];
        if (stack.ConfigFiles.FirstOrDefault() is not { } path) return [];

        try
        {
            return System.IO.File.Exists(path) ? ComposeWatch.Declares(System.IO.File.ReadAllText(path)) : [];
        }
        catch (Exception)
        {
            // The file is on another machine, or unreadable. Either way there is nothing to offer.
            return [];
        }
    }

    static string LabelFor(string id)
        => StackCommands.FirstOrDefault(c => c.Id == id).Label ?? "Watch";

    bool IsOpen(StackSummary stack)
        => _open.TryGetValue(stack.Name, out var open) ? open : stack.Status.Tone is not StateTone.Ok;

    void Toggle(StackSummary stack) => _open[stack.Name] = !IsOpen(stack);

    async Task RunAsync(StackSummary stack, string command, string label)
    {
        if (command == "watch")
        {
            await WatchAsync(stack);
            return;
        }

        if (_running is not null || _watching is not null) return;

        if (command == "down")
        {
            var answer = await Shell.ConfirmDestructiveAsync(new DestructiveConfirm(
                $"Bring {stack.Name} down?",
                "Every container in the stack is stopped and removed. Named volumes are kept — "
                + "anything written outside one is lost.",
                "Bring down"));

            if (answer != ConfirmResult.Confirm) return;
        }

        _running = $"{label} {stack.Name}";
        _output.Clear();
        _cts = new CancellationTokenSource();

        // `up` without -d would attach and never return; Dray is not a terminal and the containers
        // must outlive the button that started them.
        var arguments = command == "up" ? new[] { "up", "-d" } : [command];

        try
        {
            await foreach (var line in Engine.RunComposeAsync(stack, arguments, _cts.Token))
            {
                _output.Add(line.Text);

                // Bounded: a pull of a large stack produces thousands of lines and the panel only
                // shows the tail anyway.
                if (_output.Count > 500) _output.RemoveRange(0, _output.Count - 500);

                StateHasChanged();
            }

            Notify($"{label} finished for {stack.Name}.", ok: true);

            // A compose up that pulls images runs for minutes. Only lands when the window is not
            // in front, so watching it work is not reported twice.
            await Shell.NotifyAsync($"{label} finished", $"{stack.Name} on {Engine.Selected?.Name}.", NoticeKind.Success);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Notify(ex.Message, ok: false);
            await Shell.NotifyAsync($"{label} failed", $"{stack.Name}: {ex.Message}", NoticeKind.Error);
        }
        finally
        {
            _running = null;
            _cts?.Dispose();
            _cts = null;
        }
    }

    /// <summary>
    /// Start or stop <c>compose watch</c>.
    /// <para>
    /// Unlike every other command here, watch does not finish — it runs until it is stopped, which
    /// is why it has its own token rather than sharing the one that guards a command in flight. The
    /// output panel stays open while it runs and its Clear button becomes the way to stop it.
    /// </para>
    /// </summary>
    async Task WatchAsync(StackSummary stack)
    {
        if (_watching == stack.Name)
        {
            await _watchCts!.CancelAsync();
            return;
        }

        if (_running is not null || _watching is not null) return;

        _watching = stack.Name;
        _output.Clear();
        _watchCts = new CancellationTokenSource();

        Notify($"Watching {stack.Name}. Saving a watched file rebuilds or syncs its service.", ok: true);

        try
        {
            await foreach (var line in Engine.RunComposeAsync(stack, ["watch"], _watchCts.Token))
            {
                _output.Add(line.Text);

                if (_output.Count > 500) _output.RemoveRange(0, _output.Count - 500);

                StateHasChanged();
            }

            // Falling out without being cancelled means compose gave up — usually because the
            // stack is not up. Saying so beats a panel that simply stops producing lines.
            if (!_watchCts.IsCancellationRequested)
                Notify($"Watch ended for {stack.Name}. Compose stops watching when the stack is not up.", ok: false);
        }
        catch (OperationCanceledException)
        {
            Notify($"Stopped watching {stack.Name}.", ok: true);
        }
        catch (Exception ex)
        {
            Notify(ex.Message, ok: false);
        }
        finally
        {
            _watching = null;
            _watchCts?.Dispose();
            _watchCts = null;
        }
    }

    /// <summary>
    /// What a service row offers. Logs is the reason anyone looks at a service from this page;
    /// everything else about it is on the stack's own page.
    /// </summary>
    static readonly IReadOnlyList<RowAction> ServiceActions =
        [new("logs", "Logs", IconRef.Logs, "Read this service's output")];

    void OpenLogsByName(StackSummary stack, string service)
    {
        if (stack.Services.FirstOrDefault(s => s.Name == service) is { } found) OpenLogs(stack, found);
    }

    void OpenLogs(StackSummary stack, StackService service)
    {
        // One replica goes straight to its container's own log view rather than to an aggregated
        // one that would show a single colour key and one source.
        if (service.Replicas.FirstOrDefault() is { } only && !service.IsScaled)
        {
            Nav.NavigateTo($"/containers/{only.ShortId}");
            return;
        }

        Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(stack.Name)}/logs");
    }

    void Notify(string message, bool ok)
    {
        _notice = message;
        _noticeOk = ok;
    }

    PageChrome Chrome
    {
        get
        {
            var stacks = Engine.Stacks;

            return new PageChrome(
                "Stacks",
                Subtitle: Engine.Selected is null
                    ? null
                    : $"{stacks.Count} on {Engine.Selected.Name}",
                Search: new ChromeSearch("Filter stacks", _search),
                Actions: [ChromeAction.Secondary("logs", "Aggregated logs", IconRef.Logs)]);
        }
    }

    void HandleAction(string id)
    {
        if (id == "logs" && Engine.Stacks.FirstOrDefault() is { } first)
            Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(first.Name)}/logs");
    }

    public void Dispose()
    {
        Engine.Changed -= OnEngineChanged;
        _cts?.Cancel();
        _cts?.Dispose();

        // Leaving the page stops the watch. A compose process that outlived the window it was
        // started from would keep rebuilding with nothing on screen to say so.
        _watchCts?.Cancel();
        _watchCts?.Dispose();
    }
}
