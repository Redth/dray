@page "/stacks"
@implements IDisposable
@inject EngineManager Engine
@inject IShellBridge Shell
@inject NavigationManager Nav
@inject StackActionService Actions
@inject StackOperations Operations

<EngineScope>
    @* Declared inside EngineScope, not above it: this page's chrome reports a count that comes
       from the store, and EngineScope re-renders only its own child content. Left outside, the
       toolbar would keep the subtitle it had when the page opened. *@
    <PageChromeScope Chrome="Chrome" OnAction="HandleAction" OnSearch="s => _search = s" />

    <div class="page page--flush">
        @if (_notice is { } notice)
        {
            <div class="banner @(_noticeOk ? "banner--ok" : null)" role="status">
                <Icon Name="@(_noticeOk ? IconRef.Check : IconRef.Warning)" Size="IconSize.Sm" />
                <span>@notice</span>
                <Button Label="Dismiss" Icon="IconRef.Close" IconOnly="true" Variant="ButtonVariant.Ghost"
                        OnClick="() => _notice = null" />
            </div>
        }

        @if (NeedsFolder)
        {
            @* Asked, not assumed. Where someone keeps compose projects is theirs to say — Dray
               scans it for stacks and creates new ones there — so it is a question with a
               suggestion rather than a folder that appears in their home directory unasked. *@
            <section class="stacks__setup card" aria-labelledby="stacks-folder">
                <Icon Name="IconRef.Folder" Size="IconSize.Md" Class="stacks__setup-icon" />

                <div class="stacks__setup-text">
                    <h3 id="stacks-folder" class="panel__title">Where do your stacks live?</h3>
                    <p class="muted">
                        Choose a folder for compose projects. Dray lists every stack in it — including ones
                        you have never deployed — and keeps a stack on this list after it is brought down.
                        Your files stay plain files; <span class="mono">docker compose</span> works on them as before.
                    </p>
                </div>

                <div class="stacks__setup-actions">
                    <Button Label="@($"Use {Display(DrayPaths.SuggestedStacksFolder)}")" Variant="ButtonVariant.Primary"
                            OnClick="UseSuggestedFolderAsync" />
                    <Button Label="Choose a folder…" Variant="ButtonVariant.Secondary" OnClick="ChooseFolderAsync" />
                </div>
            </section>
        }

        @if (Engine.HasNoHosts)
        {
            <NoEngine />
        }
        else if (Visible.Count == 0 && _search.Length == 0 && Engine.Selected is { Capabilities.SupportsCompose: false } && !_composeMissing)
        {
            @* Only when the list is also empty: a Docker host without the compose CLI still has
               stacks worth reading, because Dray discovers them from container labels rather than
               from compose. This branch is for an engine compose does not target at all. *@
            <NotOnThisEngine Feature="stacks" Icon="IconRef.Stack"
                             Instead="Compose does not target this engine, so nothing here carries the labels a stack is made of. Switch to a Docker-compatible host on the Hosts page." />
        }
        else if (Visible.Count == 0)
        {
            <EmptyState Icon="IconRef.Stack"
                        Title="@(_search.Length > 0 ? "No stacks match" : "No stacks")"
                        Body="@(_search.Length > 0
                            ? "Nothing here matches the current search."
                            : "A stack appears here as soon as one is running — including one brought up from a terminal — and every compose project in your stacks folder is listed whether or not it has run. Add a folder from elsewhere with Add folder.")" />
        }
        else
        {
            <div class="stacks">
                @foreach (var stack in Visible)
                {
                    var open = IsOpen(stack);
                    var services = $"services-{stack.Name}";
                    var captured = stack;

                    <section class="stacks__card card @(stack.IsDown ? "is-down" : null)" @key="stack.Name">
                        <div class="panel__head stacks__head">
                            <button type="button" class="stacks__toggle" aria-expanded="@open"
                                    aria-controls="@services"
                                    aria-label="@($"{(open ? "Hide" : "Show")} the services in {stack.Name}")"
                                    @onclick="() => Toggle(captured)">
                                <Icon Name="IconRef.ChevronRight" Size="IconSize.Sm" />
                            </button>

                            <Icon Name="IconRef.Stack" Size="IconSize.Sm" Class="stacks__glyph" />

                            <h3 class="panel__title">
                                <a href="@($"/stacks/{Uri.EscapeDataString(stack.Name)}")">@stack.Name</a>
                            </h3>
                            <StatePill Status="stack.Status" />

                            @if (HealthPill(stack) is { } health)
                            {
                                <StatePill Status="health" />
                            }

                            <span class="muted stacks__count">
                                @stack.Services.Count service@(stack.Services.Count == 1 ? "" : "s")
                                @if (!stack.IsDown)
                                {
                                    <text> · @stack.RunningCount/@stack.ContainerCount running</text>
                                }
                            </span>

                            <span class="muted mono stacks__where" title="@Where(stack).Title">@Where(stack).Text</span>

                            @if (_composeMissing)
                            {
                                @* Compose is a separate CLI, and a stack can be running that Dray
                                   cannot drive. Saying so beats buttons that fail on click. *@
                                <span class="muted stacks__note" title="Install Docker Compose to control stacks from Dray">
                                    <Icon Name="IconRef.Warning" Size="IconSize.Sm" />
                                    compose not installed
                                </span>
                            }
                            else
                            {
                                @* The action the stack's state invites on the card, the rest behind
                                   a ⋯. The stack's name is in each accessible label rather than on
                                   screen: with a card per stack, four controls reading "Stop" are
                                   only distinguishable by which card they are in. *@
                                <RowActions Actions="CommandsFor(stack)" Visible="1"
                                            MenuLabel="@($"More commands for {stack.Name}")"
                                            OnAction="id => RunAsync(captured, id)" />
                            }
                        </div>

                        <OperationLog Stack="@stack.Name" />

                        @* The wrapper is always here so the disclosure button always has something
                           to point aria-controls at; the table itself is only built when it is
                           being shown. *@
                        <div id="@services" class="stacks__services">
                            @if (open)
                            {
                        @* Flush: this is the card's content, and a card inside a card is always
                           wrong. Columns from StackServiceGrid — narrower than the containers
                           list, because the stack's own name and state are already above it. *@
                        <DataTable TRow="StackService"
                                   Flush="true"
                                   Columns="StackServiceGrid.Columns()"
                                   Rows="stack.Services"
                                   Values="s => StackServiceGrid.Row(s)"
                                   Key="s => s.Name"
                                   ActionsFor="s => Actions.ServiceActionsFor(captured, s)"
                                   OnAction="a => RunServiceAsync(captured, a.Row, a.Action)" />
                            }
                        </div>
                    </section>
                }
            </div>
        }

        @if (Engine.Catalog?.Registry.StacksFolder is { } folder)
        {
            <p class="stacks__folder muted">
                Stacks folder <span class="mono" title="@folder">@Display(folder)</span>
                <Button Label="Change…" Variant="ButtonVariant.Ghost" OnClick="ChooseFolderAsync" />
            </p>
        }

        @if (_watching is not null || _output.Count > 0)
        {
            <section class="stacks__output card">
                <div class="panel__head">
                    <h3 class="panel__title">
                        @(_watching is { } watched ? $"Watching {watched}" : "Watch ended")
                    </h3>
                    <span class="stacks__spacer"></span>

                    @if (_watching is { } stopping)
                    {
                        <Button Label="Stop watching" Icon="IconRef.Stop" Variant="ButtonVariant.Ghost"
                                OnClick="() => _watchCts?.Cancel()" />
                    }
                    else
                    {
                        <Button Label="Clear" Icon="IconRef.Close" Variant="ButtonVariant.Ghost"
                                OnClick="() => _output.Clear()" />
                    }
                </div>

                <pre class="stacks__log mono"><code>@string.Join('\n', _output)</code></pre>
            </section>
        }
    </div>
</EngineScope>

@code {
    string _search = "";
    string? _notice;

    /// <summary>The compose that was found, or null. Its version decides whether watch is offered.</summary>
    ComposeCommand? _compose;

    /// <summary>The stack being watched, and the token that stops it. Watch does not end on its own.</summary>
    string? _watching;
    CancellationTokenSource? _watchCts;

    /// <summary>
    /// Which stacks are showing their services.
    /// <para>
    /// Closed to begin with: on a machine with a dozen stacks the page was one long table and the
    /// stack names — the thing being looked for — were the smallest part of it. A stack that is not
    /// fully running opens itself, because then the services are the reason the page was opened.
    /// </para>
    /// <para>
    /// Held per name rather than per stack, so a stack that restarts keeps its disclosure.
    /// </para>
    /// </summary>
    readonly Dictionary<string, bool> _open = [];
    bool _noticeOk;
    bool _composeMissing;

    /// <summary>What <c>compose watch</c> has printed. Every other command's output is its operation's.</summary>
    readonly List<string> _output = [];

    protected override async Task OnInitializedAsync()
    {
        Engine.Changed += OnEngineChanged;

        // An operation starting or ending changes which actions are enabled on its card.
        Operations.Changed += OnOperationChanged;

        // Probed once. A machine either has compose or it does not, and asking again per render
        // would shell out on every keystroke in the filter.
        _compose = await Engine.DetectComposeAsync();
        _composeMissing = _compose is null;
    }

    void OnEngineChanged() => InvokeAsync(StateHasChanged);

    void OnOperationChanged(StackOperation operation)
    {
        // Lines are the log's to render; the page only cares about the start and the end.
        if (operation.Lines.Count <= 1 || !operation.IsRunning) InvokeAsync(StateHasChanged);
    }

    bool NeedsFolder => Engine.Catalog is { Registry.StacksFolder: null };

    /// <summary>A home-relative path, the way a shell would show it.</summary>
    static string Display(string path)
    {
        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        return path.StartsWith(home, StringComparison.Ordinal) ? "~" + path[home.Length..] : path;
    }

    async Task UseSuggestedFolderAsync()
    {
        try
        {
            Directory.CreateDirectory(DrayPaths.SuggestedStacksFolder);
            Engine.Catalog?.Registry.SetStacksFolder(DrayPaths.SuggestedStacksFolder);
        }
        catch (Exception ex)
        {
            Notify($"Could not create {Display(DrayPaths.SuggestedStacksFolder)}: {ex.Message}", ok: false);
        }

        await Task.CompletedTask;
    }

    async Task ChooseFolderAsync()
    {
        if (await Shell.PickFolderAsync("Choose the folder your stacks live in") is { } folder)
            Engine.Catalog?.Registry.SetStacksFolder(folder);
    }

    /// <summary>
    /// Add one existing compose project from outside the stacks folder. Its files stay where they
    /// are, and Dray will never delete them — that is what makes it adopted rather than managed.
    /// </summary>
    async Task AdoptAsync()
    {
        if (Engine.Catalog is not { } catalog) return;
        if (await Shell.PickFolderAsync("Add a folder that holds a compose project") is not { } folder) return;

        if (StackFolder.Read(folder) is not { } definition)
        {
            Notify($"{Display(folder)} has no compose.yaml or docker-compose.yml, so there is no stack in it to add.", ok: false);
            return;
        }

        if (StackCatalog.IsUnder(folder, catalog.Registry.StacksFolder))
        {
            Notify($"{definition.Project} is already in the stacks folder, so it is already listed.", ok: true);
            return;
        }

        catalog.Registry.Adopt(folder);
        Notify($"Added {definition.Project}. Its files stay in {Display(folder)}, and Dray will never delete them.", ok: true);
    }

    /// <summary>Health, as a second pill — only when there is something to say.</summary>
    static ContainerStatus? HealthPill(StackSummary stack) => stack.Health switch
    {
        DockerHealth.Unhealthy => new ContainerStatus(StateTone.Danger, "▲", "Unhealthy"),
        DockerHealth.Starting => new ContainerStatus(StateTone.Warn, "◐", "Health starting"),
        _ => null,
    };

    /// <summary>Where a stack's files are, said briefly, and why that decides what it offers.</summary>
    static (string Text, string Title) Where(StackSummary stack) => stack.Provenance switch
    {
        StackProvenance.Managed => (Display(stack.WorkingDirectory ?? ""), "In the stacks folder"),
        StackProvenance.Adopted => (Display(stack.WorkingDirectory ?? ""), "Added from outside the stacks folder — Dray never deletes these files"),
        _ => ("files not on this machine", "Its compose files are on the machine that started it, so it can be started, stopped and brought down but not deployed from here"),
    };

    IReadOnlyList<StackSummary> Visible
    {
        get
        {
            var stacks = Engine.Stacks;
            if (string.IsNullOrWhiteSpace(_search)) return stacks;

            var needle = _search.Trim();

            return
            [
                .. stacks.Where(s =>
                    s.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || s.Services.Any(v => v.Name.Contains(needle, StringComparison.OrdinalIgnoreCase))),
            ];
        }
    }

    IReadOnlyList<RowAction> CommandsFor(StackSummary stack)
    {
        var commands = Actions.ActionsFor(stack).ToList();

        // Watch is offered only where it would do something: compose has to be new enough to have
        // the subcommand, and the file has to say what to watch. Without both, `compose watch`
        // exits with a message, which is a worse answer than not offering it.
        if (!stack.IsDown && WatchedServices(stack) is { Count: > 0 } services)
        {
            var on = _watching == stack.Name;

            commands.Add(new RowAction(
                "watch",
                on ? $"Stop watching {stack.Name}" : $"Watch {stack.Name}",
                on ? IconRef.Stop : IconRef.Refresh,
                on
                    ? "Stop rebuilding and syncing on file changes"
                    : $"Rebuild and sync {string.Join(", ", services)} as their files change",
                Disabled: (_watching is not null && !on) || Operations.IsBusy(stack.Name)));
        }

        return commands;
    }

    /// <summary>
    /// The services this stack's file declares something to watch for, or nothing.
    /// <para>
    /// Read from the file on every render, which is cheap and always current — the alternative is
    /// caching it and offering a stale answer after someone edits the compose file in the tab next
    /// to this one.
    /// </para>
    /// </summary>
    IReadOnlyList<string> WatchedServices(StackSummary stack)
    {
        if (!ComposeWatch.IsSupported(_compose?.Version)) return [];
        if (stack.ConfigFiles.FirstOrDefault() is not { } path) return [];

        try
        {
            return System.IO.File.Exists(path) ? ComposeWatch.Declares(System.IO.File.ReadAllText(path)) : [];
        }
        catch (Exception)
        {
            // The file is on another machine, or unreadable. Either way there is nothing to offer.
            return [];
        }
    }

    /// <summary>
    /// Closed to begin with, and open when something is wrong: then the services are the reason the
    /// page was opened. A stack that is merely down or never deployed is not wrong.
    /// </summary>
    bool IsOpen(StackSummary stack)
        => _open.TryGetValue(stack.Name, out var open) ? open : stack.Status.Tone is StateTone.Warn or StateTone.Danger;

    void Toggle(StackSummary stack) => _open[stack.Name] = !IsOpen(stack);

    async Task RunAsync(StackSummary stack, string command)
    {
        if (command == "watch")
        {
            await WatchAsync(stack);
            return;
        }

        // The output opens with the card, so starting something always shows it working.
        _open[stack.Name] = _open.GetValueOrDefault(stack.Name) || command is not ("forget" or "delete");

        if (await Actions.RunAsync(stack, command) is { } notice)
            Notify(notice, ok: !notice.Contains("busy", StringComparison.Ordinal) && !notice.StartsWith("Could not", StringComparison.Ordinal));
    }

    void RunServiceAsync(StackSummary stack, string service, string action)
    {
        if (stack.Services.FirstOrDefault(s => s.Name == service) is not { } found) return;

        switch (action)
        {
            case "logs":
                OpenLogs(stack, found);
                break;

            case "shell" when found.Replicas.FirstOrDefault(r => r.State == DockerState.Running) is { } running:
                Nav.NavigateTo($"/containers/{running.ShortId}?tab=Terminal");
                break;

            default:
                if (Actions.RunService(stack, found, action) is { } notice) Notify(notice, ok: false);
                break;
        }
    }

    /// <summary>
    /// Start or stop <c>compose watch</c>.
    /// <para>
    /// Unlike every other command here, watch does not finish — it runs until it is stopped, which
    /// is why it has its own token rather than sharing the one that guards a command in flight. The
    /// output panel stays open while it runs and its Clear button becomes the way to stop it.
    /// </para>
    /// </summary>
    async Task WatchAsync(StackSummary stack)
    {
        if (_watching == stack.Name)
        {
            await _watchCts!.CancelAsync();
            return;
        }

        if (_watching is not null || Operations.IsBusy(stack.Name)) return;

        _watching = stack.Name;
        _output.Clear();
        _watchCts = new CancellationTokenSource();

        Notify($"Watching {stack.Name}. Saving a watched file rebuilds or syncs its service.", ok: true);

        try
        {
            await foreach (var line in Engine.RunComposeAsync(stack, ["watch"], _watchCts.Token))
            {
                if (line.IsExit) continue;

                _output.Add(line.Text);

                if (_output.Count > 500) _output.RemoveRange(0, _output.Count - 500);

                StateHasChanged();
            }

            // Falling out without being cancelled means compose gave up — usually because the
            // stack is not up. Saying so beats a panel that simply stops producing lines.
            if (!_watchCts.IsCancellationRequested)
                Notify($"Watch ended for {stack.Name}. Compose stops watching when the stack is not up.", ok: false);
        }
        catch (OperationCanceledException)
        {
            Notify($"Stopped watching {stack.Name}.", ok: true);
        }
        catch (Exception ex)
        {
            Notify(ex.Message, ok: false);
        }
        finally
        {
            _watching = null;
            _watchCts?.Dispose();
            _watchCts = null;
        }
    }

    void OpenLogs(StackSummary stack, StackService service)
    {
        // One replica goes straight to its container's own log view rather than to an aggregated
        // one that would show a single colour key and one source.
        if (service.Replicas.FirstOrDefault() is { } only && !service.IsScaled)
        {
            Nav.NavigateTo($"/containers/{only.ShortId}");
            return;
        }

        Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(stack.Name)}/logs");
    }

    void Notify(string message, bool ok)
    {
        _notice = message;
        _noticeOk = ok;
    }

    PageChrome Chrome
    {
        get
        {
            var stacks = Engine.Stacks;

            return new PageChrome(
                "Stacks",
                Subtitle: Engine.Selected is null
                    ? null
                    : $"{stacks.Count} on {Engine.Selected.Name}",
                Search: new ChromeSearch("Filter stacks", _search),
                Actions:
                [
                    ChromeAction.Secondary("adopt", "Add folder", IconRef.Plus),
                    ChromeAction.Secondary("logs", "Aggregated logs", IconRef.Logs),
                ]);
        }
    }

    async Task HandleAction(string id)
    {
        if (id == "adopt") await AdoptAsync();

        if (id == "logs" && Engine.Stacks.FirstOrDefault(s => !s.IsDown) is { } first)
            Nav.NavigateTo($"/stacks/{Uri.EscapeDataString(first.Name)}/logs");
    }

    public void Dispose()
    {
        Engine.Changed -= OnEngineChanged;
        Operations.Changed -= OnOperationChanged;

        // Leaving the page stops the watch. A compose process that outlived the window it was
        // started from would keep rebuilding with nothing on screen to say so.
        _watchCts?.Cancel();
        _watchCts?.Dispose();
    }
}
