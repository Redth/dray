<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dray.Ui</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>
      Every Blazor page, component and static asset in Dray. A Razor Class Library rather than
      MSBuild globs, so all three app heads consume identical UI and wwwroot flows through the
      standard static-web-assets pipeline. See docs/ARCHITECTURE.md section 1.1.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dray.Core/Dray.Core.csproj" />
  </ItemGroup>

  <!-- Generated + gitignored, same contract as Dray.Core. -->
  <Target Name="_EnsureGeneratedAssets" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/css/tokens.css')"
           Text="wwwroot/css/tokens.css is missing. Run: node build/gen-tokens.mjs" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/icons/sprite.svg')"
           Text="wwwroot/icons/sprite.svg is missing. Run: node build/gen-icons.mjs" />
  </Target>

</Project>
