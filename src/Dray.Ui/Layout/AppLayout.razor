@inherits LayoutComponentBase
@implements IDisposable
@inject IShellState Shell
@inject ShellCapabilities Caps
@inject NavigationManager Nav
@inject IShellReadySignal Ready

<PlatformThemeSync />

@if (!Caps.HasNativeDialogs)
{
    <ConfirmHost />
}

@* Mounted once, opened from anywhere. The key handler is on the app root rather than the document
   so it cannot fire while a native menu or another window has focus. *@
<CommandPalette @ref="_palette" />

<div class="app @(Caps.HasNativeSidebar ? null : "app--webchrome")"
     tabindex="-1"
     @onkeydown="OnKeyDown">
    @if (!Caps.HasNativeSidebar)
    {
        <WebSidebar />
    }

    <div class="content">
        @if (!Caps.HasNativeToolbar)
        {
            <WebToolbar />
        }
        @Body
    </div>
</div>

@code {
    CommandPalette? _palette;

    /// <summary>
    /// ⌘K, or Ctrl+K where there is no Command key.
    /// <para>
    /// Both accepted on every platform rather than branching: the wrong one silently doing nothing
    /// is worse than both working.
    /// </para>
    /// </summary>
    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "k" or "K" && (e.MetaKey || e.CtrlKey)) _palette?.Open();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Tells the host to drop its native loading overlay and fade the WebView in.
        if (firstRender) Ready.MarkReady();
    }

    protected override void OnInitialized()
    {
        // Native chrome asks to navigate; the router is the only thing that actually can.
        Shell.NavigationRequested += HandleNavigationRequested;
        Nav.LocationChanged += HandleLocationChanged;

        Shell.NotifyRouteChanged(CurrentRoute());
    }

    string CurrentRoute()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var path = relative.Split('?', '#')[0];
        return "/" + path.TrimStart('/');
    }

    void HandleNavigationRequested(string route) => _ = InvokeAsync(() => Nav.NavigateTo(route));

    // Feeds the native sidebar's selection. ShellState swallows any echo back through
    // RequestNavigation, so a head may sync its selection freely here.
    void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => Shell.NotifyRouteChanged(CurrentRoute());

    public void Dispose()
    {
        Shell.NavigationRequested -= HandleNavigationRequested;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
