@* The engine picker for the web head, in the sidebar's top corner — where the macOS toolbar puts
   its leading menu and the Windows title bar its drop-down, so the control is in the same place on
   every head.

   It draws EnginePicker's model and builds nothing itself: the same title, tooltip and items the
   native heads show. The menu is the shared OverflowMenu — a menu stays in the page on every head
   (AGENTS.md), and one menu component means one look for every menu. *@
@implements IDisposable
@inject EnginePicker Picker

<button type="button" class="picker" title="@Model.Tooltip" aria-label="@($"Engine: {Model.Tooltip}")"
        aria-haspopup="menu" @onclick="OpenAsync">
    <Icon Name="Model.Icon" Size="IconSize.Md" />
    <span class="picker__name">@Model.Title</span>
    <Icon Name="IconRef.ChevronDown" Size="IconSize.Sm" Class="picker__chevron" />
</button>

<OverflowMenu @ref="_menu" Trigger="false" Label="Engines" Actions="Actions" OnAction="ChooseAsync" />

@if (_problem is { } problem)
{
    <p class="picker__problem" role="alert">@problem</p>
}

@code {
    OverflowMenu? _menu;
    string? _problem;

    ChromePicker Model => Picker.Current;

    protected override void OnInitialized() => Picker.Changed += OnPickerChanged;

    void OnPickerChanged(ChromePicker picker) => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The model's items as menu rows, the chosen one marked with a check rather than a colour. The
    /// separator before "Hosts and setup…" is not drawn — OverflowMenu has none, and its rows read
    /// as one list either way — so the item keeps its own icon to set it apart.
    /// </summary>
    IReadOnlyList<RowAction> Actions =>
    [
        .. Model.Items.Select(i => new RowAction(
            i.Id,
            i.Label,
            i.IsChecked ? IconRef.Check : IconRef.Host,
            Disabled: !i.IsEnabled)),
    ];

    async Task OpenAsync(MouseEventArgs e)
    {
        _problem = null;
        if (_menu is not null) await _menu.OpenAtAsync(e.ClientX, e.ClientY);
    }

    async Task ChooseAsync(string id) => _problem = await Picker.ChooseAsync(id);

    public void Dispose() => Picker.Changed -= OnPickerChanged;
}
