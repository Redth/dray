@* Rename one container.

   Validated while typing rather than on submit: the engine's own rule is knowable locally, and a
   round trip that ends in a 500 tells the user nothing they can act on. *@
@inherits DialogBody
@inject EngineManager Engine

<div class="field">
    <label class="field__label" for="rename-input">Name</label>
    <input id="rename-input" class="input" @bind="_name" @bind:event="oninput"
           autocomplete="off" spellcheck="false"
           @onkeydown="OnKeyDown" />
</div>

@if (_problem is { } problem)
{
    <p class="rename__problem">@problem</p>
}
else
{
    <p class="rename__hint muted">
        Renaming does not restart the container. Anything referring to it by its old name —
        a compose file, another container's link — keeps the old name until you change it too.
    </p>
}

@code {
    /// <summary>
    /// Open it. True once the engine has accepted the new name; the rename event updates the store,
    /// so the page has nothing to write.
    /// </summary>
    public static async Task<bool> ShowAsync(IShellBridge shell, ContainerSummary container)
    {
        var dialog = new DialogController();
        await shell.ShowDialogAsync(new DialogRequest(
            $"Rename {container.Name}",
            typeof(RenameDialog),
            Parameters: new Dictionary<string, object?> { [nameof(Container)] = container },
            Buttons: [DialogButton.Cancel(), DialogButton.Confirm("rename", "Rename")],
            Controller: dialog));

        return dialog.Result == "rename";
    }

    [Parameter, EditorRequired] public ContainerSummary Container { get; set; } = default!;

    string _name = "";
    string? _problem;
    bool _saving;

    bool CanSubmit => !_saving && ContainerName.IsValid(_name) && _name.Trim() != Container.Name;

    // Once, when the dialog opens. Not in OnParametersSet: the host re-renders the body whenever a
    // button changes, and the field would otherwise fight the user's typing.
    protected override void OnInitialized() => _name = Container.Name;

    protected override void DeclareButtons()
    {
        Button("cancel", "Cancel");
        Button("rename", "Rename", enabled: CanSubmit);
    }

    protected override async Task<bool> OnButtonAsync(string buttonId)
    {
        // A rename closes the dialog itself, and only once the engine has accepted it.
        if (buttonId == "rename")
        {
            await SubmitAsync();
            return false;
        }

        return true;
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSubmit) await SubmitAsync();
    }

    async Task SubmitAsync()
    {
        var name = _name.Trim();

        if (ContainerName.Validate(name) is { } invalid)
        {
            _problem = invalid;
            return;
        }

        _saving = true;
        _problem = null;

        // Submitted from the head's button as well as from Enter, and only an event handler
        // re-renders by itself — so the buttons learn they are working from here.
        StateHasChanged();

        try
        {
            _problem = await Engine.RenameAsync(Container.Id, name);

            // The engine accepted it; the rename event updates the store, so nothing is written
            // here. Closing is the only thing left to do.
            if (_problem is null) Close("rename");
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
