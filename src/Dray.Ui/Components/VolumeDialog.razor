@* Create a volume. A dialog body: the title and buttons are the platform's.

   Just a name — the driver options the engine accepts are for storage plugins nobody configures
   from a GUI, and offering them would be offering choices with no guidance. *@
@inherits DialogBody
@inject EngineManager Engine

<div class="field">
    <label class="field__label" for="vol-name">Name</label>
    <input id="vol-name" class="input" @bind="_name" @bind:event="oninput"
           autocomplete="off" spellcheck="false" disabled="@_saving" />
</div>

@if (_problem is { } problem)
{
    <p class="vol__problem" role="alert">@problem</p>
}
else
{
    <p class="vol__hint muted">
        The volume is empty until a container mounts it. Nothing is stored on your machine
        directly — the engine owns it, which is what makes it survive the container.
    </p>
}

@code {
    /// <summary>Closes with "create" once the engine has made it, so the list behind can refresh.</summary>
    public static DialogRequest Request() => new(
        "Create a volume",
        typeof(VolumeDialog),
        Buttons: [DialogButton.Cancel(), DialogButton.Confirm("create", "Create")],
        Size: DialogSize.Small);

    string _name = "";
    string? _problem;
    bool _saving;

    protected override IReadOnlyList<DialogButton> Buttons =>
    [
        DialogButton.Cancel(),
        DialogButton.Confirm("create", "Create") with { Enabled = ContainerName.IsValid(_name), Busy = _saving },
    ];

    protected override async Task<bool> OnPressedAsync(string id)
    {
        if (ContainerName.Validate(_name) is { } invalid)
        {
            _problem = invalid;
            return false;
        }

        _saving = true;
        _problem = null;
        StateHasChanged();

        try
        {
            _problem = await Engine.CreateVolumeAsync(_name.Trim());
            return _problem is null;
        }
        finally
        {
            _saving = false;
        }
    }
}
