@* Renders a DialogRequest for hosts with no native dialog. Mounted once by the layout.

   This is the one head that draws its own title row and button row, because a browser has no other
   frame to put them in — and it draws them with <dialog> and showModal(), which is where focus
   trapping, focus restore, Escape and the top layer come from. The native heads present an NSAlert
   sheet, a ContentDialog or an AdwMessageDialog and never render this. See docs/NATIVE-SHELL.md
   section 4. *@
@implements IDisposable
@inject WebDialogService Dialogs

@if (Dialogs.Request is { } request)
{
    <Dialog Title="@request.Title" Open="true" OpenChanged="OnOpenChanged" Class="@SizeClass(request.Size)">
        <ChildContent>
            @if (request.Subtitle is { Length: > 0 } subtitle)
            {
                <p class="dialog__subtitle muted">@subtitle</p>
            }

            @* The body is the same component every head hosts. Rendered by type rather than as a
               fragment because a fragment cannot cross into a native head's own WebView. *@
            @if (request.Controller is { } controller)
            {
                <CascadingValue Value="controller" IsFixed="true">
                    <DynamicComponent Type="request.Body" Parameters="Writable(request.ParameterMap)" />
                </CascadingValue>
            }
            else
            {
                <DynamicComponent Type="request.Body" Parameters="Writable(request.ParameterMap)" />
            }
        </ChildContent>

        <Footer>
            @foreach (var button in request.Ordered(DialogButtonOrder.CommitLast))
            {
                var captured = button;
                var state = request.Current(button);

                <Button Label="@state.Label"
                        Variant="@Variant(button.Role)"
                        Danger="@(button.Role == DialogButtonRole.Destructive)"
                        Disabled="@(!state.IsEnabled)"
                        Busy="@state.IsBusy"
                        OnClick="() => PressAsync(captured.Id)" />
            }
        </Footer>
    </Dialog>
}

@code {
    DialogController? _controller;

    protected override void OnInitialized() => Dialogs.Changed += OnChanged;

    void OnChanged()
    {
        Watch(Dialogs.Request?.Controller);
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Follow the open dialog's controller, so the button row redraws as its body changes it.</summary>
    void Watch(DialogController? controller)
    {
        if (ReferenceEquals(controller, _controller)) return;

        if (_controller is { } previous)
        {
            previous.Changed -= OnControllerChanged;
            previous.CloseRequested -= OnCloseRequested;
        }

        _controller = controller;

        if (controller is not null)
        {
            controller.Changed += OnControllerChanged;
            controller.CloseRequested += OnCloseRequested;
        }
    }

    void OnControllerChanged() => _ = InvokeAsync(StateHasChanged);

    void OnCloseRequested() => _ = InvokeAsync(() => Dialogs.Close(_controller?.Result));

    /// <summary>A button with no controller closes the dialog; with one, the body decides.</summary>
    async Task PressAsync(string buttonId)
    {
        if (Dialogs.Request?.Controller is not { } controller)
        {
            Dialogs.Close(buttonId);
            return;
        }

        if (await controller.PressAsync(buttonId)) Dialogs.Close(buttonId);
    }

    /// <summary>
    /// Escape and the backdrop. Without a controller, a dismissal rather than a choice. With one,
    /// they press cancel — which a body may refuse while work it cannot abandon is running, in which
    /// case the dialog is shown again rather than vanishing with the work still going.
    /// </summary>
    async Task OnOpenChanged(bool open)
    {
        if (open) return;

        if (Dialogs.Request is not { Controller: { } controller } request)
        {
            Dialogs.Close(null);
            return;
        }

        if (request.CancelButton is not { } cancel)
        {
            controller.Dismissed();
            Dialogs.Close(null);
            return;
        }

        if (await controller.PressAsync(cancel.Id)) Dialogs.Close(cancel.Id);
        else StateHasChanged();
    }

    static ButtonVariant Variant(DialogButtonRole role) => role switch
    {
        DialogButtonRole.Confirm => ButtonVariant.Primary,

        // The committing button in a dialog is the one place a filled destructive button is right:
        // it is the decision itself, not a control sitting beside other controls. DESIGN.md 2.5.
        DialogButtonRole.Destructive => ButtonVariant.Primary,
        DialogButtonRole.Cancel => ButtonVariant.Ghost,
        _ => ButtonVariant.Secondary,
    };

    static string SizeClass(DialogSize size) => size switch
    {
        DialogSize.Small => "dialog--sm",
        DialogSize.Large => "dialog--lg",
        _ => "",
    };

    /// <summary>
    /// DynamicComponent wants a mutable dictionary. Copied rather than cast, so a caller cannot
    /// hand one dictionary to two dialogs and have the second edit the first.
    /// </summary>
    static Dictionary<string, object> Writable(IReadOnlyDictionary<string, object?> parameters)
    {
        var copy = new Dictionary<string, object>(StringComparer.Ordinal);

        foreach (var (key, value) in parameters)
        {
            if (value is not null) copy[key] = value;
        }

        return copy;
    }

    public void Dispose()
    {
        Dialogs.Changed -= OnChanged;
        Watch(null);
    }
}
