@* Teaches the interface. Never "Nothing here." — name the thing, say why it might be empty,
   and offer the one action that fixes it (DESIGN.md section 6). *@

<div class="empty">
    <Icon Name="Icon" Size="IconSize.Xl" Class="empty__icon" />
    <div class="empty__title">@Title</div>
    @if (Body is not null)
    {
        <p class="empty__body">@Body</p>
    }
    @if (Actions is not null)
    {
        <div class="empty__actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Body { get; set; }
    [Parameter] public IconRef Icon { get; set; } = IconRef.Container;
    [Parameter] public RenderFragment? Actions { get; set; }
}
