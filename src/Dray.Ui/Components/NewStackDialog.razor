@* The New stack window: a name, a folder, and then the file itself beside its variables — written
   here, not previewed.

   Where the file starts is asked once, over the editors, as the window opens: a blank template, an
   image found the way Pull finds one, or a `docker run` line from a README. After that the file is
   the user's, checked as it is typed — by the YAML language server against the Compose
   Specification, by Dray's own lint, and by compose itself against a private copy — and every
   ${VAR} in it shows the value it will read, or a mask where the value is secret. *@
@inherits DialogBody
@implements IAsyncDisposable
@inject EngineManager Engine
@inject IJSRuntime JS
@inject IShellBridge Shell
@inject ShellCapabilities Caps

<div class="ns">
    <div class="ns__strip">
        <div class="field ns__name">
            <label class="field__label" for="ns-name">Name</label>
            <input id="ns-name" class="input mono" @bind="Request.Name" @bind:event="oninput"
                   placeholder="shop" spellcheck="false" autocomplete="off" />
        </div>

        @if (Request.Folders.Count > 1)
        {
            <div class="field ns__folder">
                <label class="field__label" for="ns-folder">Folder</label>
                <select id="ns-folder" class="input mono" @bind="Request.StacksFolder">
                    @foreach (var folder in Request.Folders)
                    {
                        <option value="@folder">@Display(folder)</option>
                    }
                </select>
            </div>
        }

        @if (_started is { } started)
        {
            <div class="ns__origin">
                <span class="muted">Started from</span>
                <span class="ns__origin-what @(started == NewStackSource.Blank ? null : "mono")" title="@StartedFrom">@StartedFrom</span>
                <Button Label="Start over…" Variant="ButtonVariant.Ghost" OnClick="StartOver" />
            </div>
        }
    </div>

    @if (Problem is { } problem)
    {
        <p class="ns__problem" role="alert">@problem</p>
    }
    else if (_actionNote is { } note)
    {
        <p class="@(_actionOk ? "ns__hint muted" : "ns__problem")" role="status">@note</p>
    }

    <div class="ns__work">
        <section class="ns__file" aria-label="compose.yaml">
            <div class="ns__head">
                <span class="panel__title">compose.yaml</span>
                <span class="ns__path mono muted" title="@FilePath">@Display(FilePath)</span>
                <span class="ns__spacer"></span>

                @if (CanUseForms)
                {
                    <OverflowMenu Actions="ComposeEditorActions.AddMenu(ComposeDocument.Parse(_text).Services.Count > 0)"
                                  Label="Add to this compose file" TriggerText="Add" TriggerIcon="IconRef.Plus"
                                  TriggerClass="btn--ghost" OnAction="RunActionAsync" />
                }

                <span class="ns__verdict ns__verdict--@VerdictTone" role="status">
                    <Icon Name="@VerdictIcon" Size="IconSize.Sm" />
                    @VerdictText
                </span>
            </div>

            <CodeEditor @ref="_editor" Bare="true" Schema="compose"
                        File="_file" OnSave="(_, _) => Task.FromResult<string?>(null)"
                        Annotations="_annotations" Problems="_problems"
                        Lenses="@(CanUseForms && _started is not null ? ComposeEditorActions.Lenses(_text) : [])" OnLens="RunActionAsync"
                        OnTextChanged="OnTextChangedAsync" OnDirtyChanged="d => _edited = d" />

            @if (_unplaced.Count > 0)
            {
                @* What compose said without saying where. Still said, below the file it is about. *@
                <ul class="ns__unplaced">
                    @foreach (var message in _unplaced)
                    {
                        <li><Icon Name="IconRef.Warning" Size="IconSize.Sm" /><span>@message</span></li>
                    }
                </ul>
            }
        </section>

        <section class="ns__vars" aria-label="Variables">
            <div class="ns__head">
                <span class="panel__title">Variables</span>
                <span class="ns__path mono muted">@DotEnvFile.FileName</span>
            </div>

            <div class="ns__vars-body">
                <EnvEditor Variables="_env" VariablesChanged="OnVariablesChangedAsync" />

                @if (Request.Result is { Notes.Count: > 0 } result)
                {
                    <ul class="ns__notes">
                        @foreach (var note in result.Notes)
                        {
                            <li class="note"><Icon Name="IconRef.Info" Size="IconSize.Sm" /><span>@note</span></li>
                        }
                    </ul>
                }

                <p class="ns__hint muted">
                    Compose reads these from <span class="mono">.env</span> and fills in each
                    <span class="mono">${NAME}</span> in the file — the value is shown beside it there.
                    Secrets belong here rather than in the file, which is the one people commit and paste.
                </p>
            </div>
        </section>

        @if (_started is null)
        {
            @* Asked once, over the editors, rather than kept in a strip above them: it is the first
               decision and then it is made. Start over brings it back. *@
            <div class="ns__start">
                <div class="ns__start-card">
                    <h2 class="ns__start-title">Start from</h2>

                    <div class="ns__choices">
                        <button type="button" class="ns__choice" @onclick="() => StartAsync(NewStackSource.Blank)">
                            <Icon Name="IconRef.File" Size="IconSize.Md" />
                            <span class="ns__choice-title">Blank</span>
                            <span class="ns__choice-body muted">A one-service template to edit.</span>
                        </button>

                        <button type="button" class="ns__choice @(_asking == NewStackSource.Image ? "is-selected" : null)"
                                aria-pressed="@((_asking == NewStackSource.Image).ToString().ToLowerInvariant())"
                                @onclick="ChooseImageAsync">
                            <Icon Name="IconRef.Image" Size="IconSize.Md" />
                            <span class="ns__choice-title">An image</span>
                            <span class="ns__choice-body muted">Search Docker Hub and your registries, with tags and platforms.</span>
                        </button>

                        <button type="button" class="ns__choice @(_asking == NewStackSource.Run ? "is-selected" : null)"
                                aria-pressed="@((_asking == NewStackSource.Run).ToString().ToLowerInvariant())"
                                @onclick="() => _asking = NewStackSource.Run">
                            <Icon Name="IconRef.Terminal" Size="IconSize.Md" />
                            <span class="ns__choice-title">A docker run command</span>
                            <span class="ns__choice-body muted">Paste one from a README; it becomes a service.</span>
                        </button>
                    </div>

                    @if (_asking == NewStackSource.Run)
                    {
                        <div class="field ns__ask">
                            <label class="field__label" for="ns-run">docker run command <span class="muted">— converted by composerize, the library Dockge uses</span></label>
                            <textarea id="ns-run" class="input mono ns__area" rows="3" @bind="Request.RunLine" @bind:event="oninput"
                                      placeholder="docker run -d -p 8080:80 -e TZ=UTC nginx:alpine" spellcheck="false"></textarea>
                            <div class="ns__ask-row">
                                <span class="ns__problem">@_startProblem</span>
                                <Button Label="Convert" Variant="ButtonVariant.Primary" Busy="_converting"
                                        Disabled="@(Request.RunLine.Trim().Length == 0 || _converting)"
                                        OnClick="() => StartAsync(NewStackSource.Run)" />
                            </div>
                        </div>
                    }
                    else if (_asking == NewStackSource.Image)
                    {
                        @* Where a dialog cannot open over this one, the name is typed rather than found. *@
                        <div class="field ns__ask">
                            <label class="field__label" for="ns-image">Image</label>
                            <input id="ns-image" class="input mono" @bind="Request.Image" @bind:event="oninput"
                                   placeholder="postgres:16" spellcheck="false" autocomplete="off" />
                            <div class="ns__ask-row">
                                <span class="ns__problem">@_startProblem</span>
                                <Button Label="Use image" Variant="ButtonVariant.Primary"
                                        Disabled="@(Request.Image.Trim().Length == 0)"
                                        OnClick="() => StartAsync(NewStackSource.Image)" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NewStackRequest Request { get; set; } = default!;

    /// <summary>Open the window, and return the new stack's name once it has been written — or null.</summary>
    public static async Task<string?> ShowAsync(IShellBridge shell, NewStackRequest request)
    {
        var session = new DialogSession(new DialogRequest(
            "New stack",
            typeof(NewStackDialog),
            new Dictionary<string, object?> { [nameof(Request)] = request },
            [DialogButton.Cancel(), DialogButton.Confirm("create", "Create")],
            Size: DialogSize.Window));

        await shell.ShowDialogAsync(session);

        return session.Result == "create" ? session.Value as string : null;
    }

    CodeEditor? _editor;
    IJSObjectReference? _composerize;

    /// <summary>What the editor opens with. Its text is the editor's from then on.</summary>
    FileContent _file = new() { Path = "compose.yaml" };

    /// <summary>The text as last reported by the editor — what the marks and the checks are about.</summary>
    string _text = "";

    IReadOnlyList<EnvVar> _env = [];
    IReadOnlyList<EditorAnnotation> _annotations = [];
    IReadOnlyList<EditorProblem> _problems = [];
    IReadOnlyList<string> _unplaced = [];

    /// <summary>How the file was started, once it has been. Null while the choice is still on screen.</summary>
    NewStackSource? _started;

    /// <summary>The choice being filled in over the editors — the run line or the image — before it starts the file.</summary>
    NewStackSource? _asking;

    string? _startProblem;
    bool _converting;
    bool _edited;
    bool _creating;
    string? _createProblem;

    /// <summary>The private copy compose checks, and the check in flight.</summary>
    string? _draft;
    CancellationTokenSource? _check;
    bool _checking;
    ComposeConfig? _config;

    string FilePath => Path.Combine(Request.StacksFolder, Request.Name.Length > 0 ? Request.Name : "…", "compose.yaml");

    string StartedFrom => _started switch
    {
        NewStackSource.Image => Request.Image.Trim(),
        NewStackSource.Run => "a docker run command",
        _ => "a blank template",
    };

    protected override string? Title => Request.Name.Length > 0 ? $"New stack: {Request.Name}" : "New stack";

    protected override string? Subtitle => $"In {Display(Request.StacksFolder)}";

    protected override IReadOnlyList<DialogButton> Buttons =>
    [
        DialogButton.Cancel() with { Enabled = !_creating },
        DialogButton.Confirm("create", "Create") with
        {
            Enabled = !_creating && _started is not null && Request.Name.Length > 0 && Request.NameProblem is null,
            Busy = _creating,
        },
    ];

    /// <summary>The one thing wrong right now, most fundamental first.</summary>
    string? Problem => _createProblem ?? Request.NameProblem;

    // ---------------------------------------------------------------- starting

    async Task ChooseImageAsync()
    {
        _startProblem = null;

        // Found, not typed, where a dialog can open over this window: Pull's own search, with its
        // registries, tags, and what each tag was built for.
        if (Caps.HasDialogWindows)
        {
            if (await PullDialog.ChooseAsync(Shell, "Choose an image for the stack") is not { } reference) return;

            Request.Image = reference;
            await StartAsync(NewStackSource.Image);
            return;
        }

        _asking = NewStackSource.Image;
    }

    async Task StartAsync(NewStackSource source)
    {
        _startProblem = null;
        _converting = source == NewStackSource.Run;
        StateHasChanged();

        try
        {
            var (result, problem) = await BuildAsync(source, Closing);

            if (result is null)
            {
                _startProblem = problem;
                return;
            }

            Request.Source = source;
            Request.Result = result;
            _env = result.Environment;
            _started = source;
            _asking = null;

            // A name to begin from, where the start suggests one and none has been typed: the image's
            // own, as compose would name its service.
            if (Request.Name.Length == 0 && source == NewStackSource.Image && SuggestedName(Request.Image) is { } suggested)
                Request.Name = suggested;

            if (_editor is not null) await _editor.SetTextAsync(result.Compose);
            else _file = new FileContent { Path = "compose.yaml", Text = result.Compose };

            await OnTextChangedAsync(result.Compose);
            _edited = false;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _converting = false;
            StateHasChanged();
        }
    }

    async Task StartOver()
    {
        // Starting again writes the file again. Asked only where there is something of the user's to lose.
        if (_edited)
        {
            var answer = await Shell.ConfirmDestructiveAsync(new DestructiveConfirm(
                "Start over?",
                "The file and its variables are written again from the start you choose, and the edits you made to them are lost.",
                "Start over"));

            if (answer != ConfirmResult.Confirm) return;
        }

        _started = null;
        _asking = null;
        _startProblem = null;
    }

    /// <summary>The repository's last segment, as a stack name: <c>library/postgres:16</c> is <c>postgres</c>.</summary>
    static string? SuggestedName(string reference)
    {
        var path = reference.Split('@')[0];
        var slash = path.LastIndexOf('/');
        var name = path[(slash + 1)..].Split(':')[0].ToLowerInvariant();

        return name.Length > 0 ? name : null;
    }

    // ---------------------------------------------------------------- checking as it is written

    async Task OnTextChangedAsync(string text)
    {
        _text = text;
        _annotations = ComposeMarks.Annotations(text, _env);
        Lint();
        await CheckSoonAsync();
    }

    async Task OnVariablesChangedAsync(IReadOnlyList<EnvVar> variables)
    {
        _env = variables;
        _annotations = ComposeMarks.Annotations(_text, _env);

        // Compose reads the values too: a required ${VAR} is an error until it has one.
        await CheckSoonAsync();
    }

    /// <summary>Dray's own checks: what compose accepts but will not do what it says.</summary>
    IReadOnlyList<EditorProblem> _lint = [];

    void Lint()
    {
        var published = Engine.Store.Containers
            .Where(c => c.State == DockerState.Running)
            .SelectMany(c => c.Ports.Select(p => new PublishedPort(p.HostPort, p.Protocol, c.Stack is { } stack ? $"{c.Name} ({stack})" : c.Name)))
            .ToList();

        var context = new LintContext(published, Engine.Selected?.Endpoint.IsRemote == true);

        try
        {
            var document = ComposeDocument.Parse(_text);
            _lint = [.. ComposeLint.Check(document, context).Select(f => ComposeMarks.ToEditor(new ComposeProblem(f.Message, ProblemSeverity.Warning, null), f.Range, "dray"))];
        }
        catch (Exception)
        {
            // Not YAML yet. The language server is already underlining why.
            _lint = [];
        }

        Merge();
    }

    /// <summary>
    /// Ask compose what it makes of the file, a moment after the typing stops.
    /// <para>
    /// Against a private copy in a temporary folder, because the stack's own folder does not exist
    /// until Create. The variables go into its <c>.env</c> so compose can check what they feed — but
    /// a secret's value is never written for this: a placeholder stands in, which is all a check of
    /// the file's shape needs, and the real one reaches disk only when the user creates the stack.
    /// </para>
    /// </summary>
    async Task CheckSoonAsync()
    {
        _check?.Cancel();
        var cts = _check = CancellationTokenSource.CreateLinkedTokenSource(Closing);

        try
        {
            await Task.Delay(700, cts.Token);

            _checking = true;
            StateHasChanged();

            _draft ??= Directory.CreateTempSubdirectory("dray-draft-").FullName;
            var compose = Path.Combine(_draft, "compose.yaml");

            await File.WriteAllTextAsync(compose, _text, cts.Token);
            await File.WriteAllTextAsync(
                Path.Combine(_draft, DotEnvFile.FileName),
                DotEnvFile.Serialize([.. _env.Select(v => v.IsSecret ? v with { Value = "dray-placeholder" } : v)]),
                cts.Token);

            var draft = new StackSummary { Name = "dray-draft", ConfigFiles = [compose], WorkingDirectory = _draft, Provenance = StackProvenance.Adopted };
            var config = await Engine.ValidateComposeAsync(draft, cts.Token);
            if (cts.IsCancellationRequested) return;

            _config = config;

            var placed = config.Place([(compose, ComposeDocument.Parse(_text))]);
            _compose = [.. placed.Where(p => p.Range is not null).Select(p => ComposeMarks.ToEditor(p.Problem, p.Range!, "compose"))];
            _unplaced = [.. placed.Where(p => p.Range is null).Select(p => p.Problem.Message)];
            Merge();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _unplaced = [$"Compose could not check the file: {ex.Message}"];
        }
        finally
        {
            if (_check == cts) _checking = false;
            StateHasChanged();
        }
    }

    IReadOnlyList<EditorProblem> _compose = [];

    void Merge() => _problems = [.. _compose, .. _lint];

    string VerdictTone => _checking || _config is null ? "busy"
        : !_config.IsValid ? "danger"
        : _problems.Count > 0 || _unplaced.Count > 0 ? "warn"
        : "ok";

    IconRef VerdictIcon => VerdictTone switch
    {
        "ok" => IconRef.Check,
        "warn" => IconRef.Warning,
        "danger" => IconRef.Error,
        _ => IconRef.Refresh,
    };

    string VerdictText => VerdictTone switch
    {
        "busy" => _config is null ? "Checking…" : "Checking again…",
        "danger" => "Compose rejects this",
        "warn" => _problems.Count + _unplaced.Count == 1 ? "1 thing to look at" : $"{_problems.Count + _unplaced.Count} things to look at",
        _ => "Compose accepts this",
    };

    // ---------------------------------------------------------------- forms over the file

    /// <summary>
    /// The Add menu and the Edit lenses open a form over this window. Where a dialog cannot open over
    /// another — every head whose New stack is itself a dialog — they are not offered.
    /// </summary>
    bool CanUseForms => Caps.HasDialogWindows;

    string? _actionNote;
    bool _actionOk;

    async Task RunActionAsync(string command)
    {
        if (_editor is null) return;

        _actionNote = null;

        if (await ComposeEditorActions.RunAsync(Shell, _editor, command) is { } outcome)
        {
            // Here nothing is saved until Create, so the sentence about saving is the stack page's.
            _actionNote = outcome.Ok ? null : outcome.Message;
            _actionOk = outcome.Ok;
        }
    }

    // ---------------------------------------------------------------- creating

    protected override async Task<bool> OnPressedAsync(string id)
    {
        if (id != "create") return true;

        _creating = true;
        _createProblem = null;
        StateHasChanged();

        try
        {
            // What is in the editor, edited or not, and the variables as they now stand: what the
            // window shows is what is written.
            var text = (_editor is null ? null : await _editor.GetTextAsync()) ?? _text;
            var stack = new AuthoredStack(text, _env, Request.Result?.Notes ?? []);

            var (_, problem) = StackCreation.Create(Request.StacksFolder, Request.Name, stack);

            if (problem is null) Close("create", Request.Name);
            else _createProblem = problem;
        }
        catch (Exception ex)
        {
            _createProblem = $"Nothing was written: {ex.Message}";
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }

        // Closed above on success; left open, with the reason on screen, otherwise.
        return false;
    }

    /// <summary>The file a start makes. Null with a sentence when what was given cannot make one.</summary>
    async Task<(AuthoredStack? Result, string? Problem)> BuildAsync(NewStackSource source, CancellationToken ct)
    {
        switch (source)
        {
            case NewStackSource.Image:
            {
                var image = Request.Image.Trim();
                return image.Length == 0 ? (null, "Choose an image first.") : (ComposeAuthoring.FromImage(image, []), null);
            }

            case NewStackSource.Run:
            {
                var line = Request.RunLine.Trim();
                if (line.Length == 0) return (null, "Paste a docker run command first.");
                if (!line.StartsWith("docker ", StringComparison.Ordinal) && !line.StartsWith("podman ", StringComparison.Ordinal))
                    return (null, "Paste the whole command, starting with docker run.");

                try
                {
                    _composerize ??= await JS.InvokeAsync<IJSObjectReference>("import", ct, "./_content/Dray.Ui/js/composerize.js");
                    var yaml = await _composerize.InvokeAsync<string>("convert", ct, line);

                    return (ComposeAuthoring.FromConverted(yaml), null);
                }
                catch (JSException ex)
                {
                    // composerize names the flag it could not map; that is the useful sentence.
                    return (null, $"composerize could not convert this: {ex.Message.Split('\n')[0]}");
                }
            }

            default:
                return (ComposeAuthoring.Blank(), null);
        }
    }

    static string Display(string path)
    {
        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        return path.StartsWith(home, StringComparison.Ordinal) ? "~" + path[home.Length..] : path;
    }

    public async ValueTask DisposeAsync()
    {
        _check?.Cancel();

        // The private copy goes with the window.
        if (_draft is { } draft)
        {
            try
            {
                Directory.Delete(draft, recursive: true);
            }
            catch (IOException)
            {
            }
        }

        if (_composerize is not null)
        {
            try
            {
                await _composerize.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
