@* Build an image from a Dockerfile.

   The engine's output is shown verbatim rather than reformatted: people read build logs by pattern,
   and rewriting them makes a familiar thing unfamiliar at exactly the moment something has gone
   wrong. *@
@inherits DialogBody
@implements IAsyncDisposable
@inject EngineManager Engine
@inject IShellBridge Shell
@inject ShellCapabilities Caps

<div class="field">
    <label class="field__label" for="build-context">Build context</label>
    <div class="build__path">
        <input id="build-context" class="input mono" placeholder="/path/to/project"
               @bind="_context" @bind:event="oninput" spellcheck="false" disabled="@_building" />

        @if (Caps.HasNativeDialogs)
        {
            <Button Label="Choose…" Icon="IconRef.Files" Variant="ButtonVariant.Secondary"
                    Disabled="_building" OnClick="PickAsync" />
        }
    </div>
</div>

<div class="field">
    <label class="field__label" for="build-tag">
        Tag <span class="muted">— optional; an untagged build is dangling</span>
    </label>
    <input id="build-tag" class="input mono" placeholder="myapp:dev"
           @bind="_tag" @bind:event="oninput" spellcheck="false" disabled="@_building" />
</div>

@* Only when there is a choice to make. A machine without buildx, or with nothing but the
   default builder, is not offered a picker that can only say one thing. *@
@if (_builders.Count > 0)
{
    <div class="field">
        <label class="field__label" for="build-builder">
            Builder
            <span class="muted">— buildx, for cross-platform builds and shared cache</span>
        </label>

        <select id="build-builder" class="input" @bind="_builder" disabled="@_building">
            <option value="">This engine</option>

            @foreach (var builder in _builders)
            {
                <option value="@builder.Name" disabled="@(!builder.IsUsable)">
                    @builder.Name@(builder.IsCurrent ? " (current)" : "")@(builder.IsUsable ? "" : " — unavailable")
                </option>
            }
        </select>

        @if (_builders.FirstOrDefault(b => b.Name == _builder) is { Problem: { } problem })
        {
            @* Said before the build rather than after: a builder configured against an
               endpoint that no longer exists fails in a way nothing on screen explains. *@
            <p class="build__hint muted">@problem</p>
        }
        else if (_builders.FirstOrDefault(b => b.Name == _builder) is { Platforms.Count: > 0 } chosen)
        {
            <p class="build__hint muted">Builds for @string.Join(", ", chosen.Platforms).</p>
        }
    </div>
}

<div class="build__options">
    <label class="toggle">
        <input type="checkbox" @bind="_noCache" disabled="@_building" />
        <span>Ignore the cache</span>
    </label>

    <label class="toggle">
        <input type="checkbox" @bind="_pull" disabled="@_building" />
        <span>Pull a newer base image</span>
    </label>
</div>

@if (_error is { } error)
{
    <p class="build__error">@error</p>
}
else if (_output.Count == 0)
{
    <p class="build__hint muted">
        Everything under the context is sent to the engine, so choose the project directory
        rather than a parent of it. A <span class="mono">.dockerignore</span> keeps the
        upload small.
    </p>
}

@if (_output.Count > 0)
{
    <pre class="build__log mono"><code>@string.Join('\n', _output)</code></pre>
}

@if (_done is { } done)
{
    <p class="build__done">@done</p>
}

@code {
    /// <summary>
    /// Open it. Completes when it closes; the page refreshes then, and the build — which may have
    /// finished long before — needs no callback across into the dialog's own WebView to say so.
    /// </summary>
    public static async Task ShowAsync(IShellBridge shell)
    {
        var dialog = new DialogController();
        await shell.ShowDialogAsync(new DialogRequest(
            "Build an image",
            typeof(BuildDialog),
            Buttons: [DialogButton.Cancel("Close"), DialogButton.Confirm("build", "Build")],
            Controller: dialog));
    }

    protected override void DeclareButtons()
    {
        Button("cancel", _building ? "Cancel" : "Close");
        Button("build", _building ? Progress : "Build",
            enabled: !_building && _context.Trim().Length > 0, busy: _building);
    }

    protected override async Task<bool> OnButtonAsync(string buttonId)
    {
        if (buttonId == "build")
        {
            // Started and left running: the dialog stays open to show it.
            _ = StartAsync();
            return false;
        }

        // Cancelling stops Dray reading the stream; the engine finishes the layer it is on. Saying
        // otherwise would be a lie — a build is not a transaction Dray can roll back.
        if (_cts is { } cts) await cts.CancelAsync();
        return true;
    }

    string _context = "";
    string _tag = "";
    bool _noCache;
    bool _pull;

    /// <summary>
    /// The buildx builder to build on, or the empty string for the engine's own builder.
    /// <para>
    /// Empty by default even when buildx has a current builder. Dray's build goes through the
    /// Engine API, which needs nothing installed and streams the engine's own output; switching to
    /// a separate program with its own cache and its own way to fail is a choice someone makes,
    /// not one made for them.
    /// </para>
    /// </summary>
    string _builder = "";

    IReadOnlyList<BuildxBuilder> _builders = [];

    string? Builder => _builder.Length == 0 ? null : _builder;

    /// <summary>
    /// Asked for once, when the dialog opens rather than when the page loads: this shells out to a
    /// program that may not be installed, and most sessions never build anything.
    /// </summary>
    protected override async Task OnInitializedAsync() => _builders = await Engine.ListBuildersAsync();

    bool _building;
    string? _error;
    string? _done;

    readonly List<string> _output = [];
    CancellationTokenSource? _cts;
    (int Current, int Total)? _step;

    /// <summary>
    /// The button's label while building. The engine reports steps, not a percentage, so this
    /// counts steps rather than inventing one.
    /// </summary>
    string Progress => _step is { } s ? $"Step {s.Current}/{s.Total}…" : "Building…";

    async Task PickAsync()
    {
        if (await Shell.PickFolderAsync("Choose the build context") is { } chosen) _context = chosen;
    }

    async Task StartAsync()
    {
        if (_building) return;

        _building = true;
        _error = null;
        _done = null;
        _step = null;
        _output.Clear();
        _cts = new CancellationTokenSource();

        // Started from the head's button, and only an event handler re-renders by itself — so the
        // buttons learn they are busy from here.
        StateHasChanged();

        var request = new BuildRequest(
            _context.Trim(),
            Tag: string.IsNullOrWhiteSpace(_tag) ? null : _tag.Trim(),
            NoCache: _noCache,
            Pull: _pull);

        try
        {
            await foreach (var step in Engine.BuildImageAsync(request, Builder, _cts.Token))
            {
                if (step.IsError)
                {
                    _error = step.Error;
                    break;
                }

                if (step.Step is { } progress) _step = progress;

                _output.Add(step.Text);

                // Bounded: a large build produces thousands of lines and only the tail is on screen.
                if (_output.Count > 800) _output.RemoveRange(0, _output.Count - 800);

                StateHasChanged();
            }

            if (_error is null)
            {
                _done = request.Tag is null ? "Built." : $"Built {request.Tag}.";

                await Shell.NotifyAsync(
                    "Build finished", request.Tag is null ? "The image was built." : $"{request.Tag} was built.",
                    NoticeKind.Success);
            }
            else
            {
                await Shell.NotifyAsync("Build failed", _error, NoticeKind.Error);
            }
        }
        catch (OperationCanceledException)
        {
            _done = "Build cancelled.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _building = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is { } cts)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
    }
}
