@* aria-label is set even when the label is visible: a narrow toolbar hides the text and keeps the
   button, and a control whose only name was the text it just dropped is unreachable to anything
   that is not looking at it. The two always say the same thing. *@

<button type="button"
        class="btn btn--@Variant.ToString().ToLowerInvariant() @(Danger ? "btn--danger" : null) @(IconOnly ? "btn--icon" : null) @Class"
        disabled="@(Disabled || Busy)"
        title="@(Tooltip ?? Label)"
        aria-label="@Label"
        @onclick="OnClick">
    @if (Icon is { } icon)
    {
        <Icon Name="icon" Size="IconSize.Md" />
    }
    @if (!IconOnly)
    {
        <span>@Label</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public IconRef? Icon { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;

    /// <summary>Applies the danger tone. Orthogonal to weight — see <see cref="ButtonVariant"/>.</summary>
    [Parameter] public bool Danger { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Work in flight. Disables the button; the caller shows progress elsewhere.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    // Deliberately no CaptureUnmatchedValues. A catch-all makes a misspelt parameter compile
    // silently and do nothing: `IsEnabled="..."` on this component was accepted as a stray HTML
    // attribute for weeks, so Save, Revert, Rename and four other buttons never actually disabled.
    // Without it, the same typo is a build error. Anything genuinely needed — a data attribute, an
    // aria role — is added here as a real parameter.
}
