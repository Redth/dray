@* One probed capability. When absent, says what the user loses rather than just showing a cross —
   docs/ARCHITECTURE.md 2.1: screens explain the gap instead of surfacing an exception. *@

<div class="cap">
    <Icon Name="@(Supported ? IconRef.Check : IconRef.Close)" Size="IconSize.Sm"
          Class="@(Supported ? "cap__yes" : "cap__no")" />
    <div>
        <div class="cap__name">@Name</div>
        @if (!Supported)
        {
            <div class="cap__absent">@Absent</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public bool Supported { get; set; }
    [Parameter] public string? Absent { get; set; }
}
