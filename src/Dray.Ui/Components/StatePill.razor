@* The only component allowed to render container state (DESIGN.md section 2.4).
   Tint + glyph + word, always all three. *@

@* The word is in its own element so a narrow container can take it out of the layout without
   taking it away: it stays in the accessible name and in the tooltip, and the glyph and tint carry
   the state on screen. See DESIGN.md section 2.4. *@

<span class="pill pill--@Tone" title="@Status.Label">
    <span class="pill__glyph" aria-hidden="true">@Status.Glyph</span>
    <span class="pill__word">@Status.Label</span>
</span>

@code {
    [Parameter, EditorRequired] public ContainerStatus Status { get; set; } = default!;

    string Tone => Status.Tone switch
    {
        StateTone.Ok => "ok",
        StateTone.Warn => "warn",
        StateTone.Danger => "danger",
        _ => "neutral",
    };
}
