@implements IAsyncDisposable
@inject IJSRuntime JS

@* A row of controls that gives way as the window narrows.

   The first action is the most important one and is the last to go: the row is collapsed from its
   end, and whatever no longer fits moves into a menu. So a stack card in a narrow window still
   offers Up, and Down — the destructive one — is the first thing to be put away.

   The browser measures and C# decides (OverflowFit), which keeps the interesting half testable.
   The menu is a real popover so it can escape the card's own rounded clip, and light dismiss,
   Escape and the top layer come with it rather than being hand-rolled. *@

<div class="actions" @ref="_row">
    @foreach (var action in Shown)
    {
        var captured = action;

        <Button Label="@action.Label"
                Icon="action.Icon"
                IconOnly="true"
                Tooltip="@action.Tooltip"
                Variant="ButtonVariant.Secondary"
                Danger="action.Danger"
                Disabled="action.Disabled"
                OnClick="() => PickAsync(captured)" />
    }

    @* The menu itself is OverflowMenu, which is also used on its own where a row of buttons was
       never wanted — a tab bar's corner. This component's job is deciding what goes in it. *@
    <OverflowMenu Actions="Hidden" Label="@MenuLabel" OnAction="OnAction" />
</div>

@code {
    /// <summary>
    /// The actions, most important first. The order is the priority: the row keeps its head and
    /// sheds its tail.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyList<RowAction> Actions { get; set; } = [];

    [Parameter] public EventCallback<string> OnAction { get; set; }

    /// <summary>Names the overflow control. Says what it holds, since its contents change.</summary>
    [Parameter] public string MenuLabel { get; set; } = "More actions";

    ElementReference _row;

    IJSObjectReference? _module;
    IJSObjectReference? _observer;
    DotNetObjectReference<ActionRow>? _self;

    double _available;
    double _item;
    double _gap;

    int Fit => OverflowFit.Visible(_available, _item, _gap, Actions.Count);

    IReadOnlyList<RowAction> Shown => [.. Actions.Take(Fit)];

    IReadOnlyList<RowAction> Hidden => [.. Actions.Skip(Fit)];

    /// <summary>
    /// The row's width and the size of one control, straight from the browser.
    /// </summary>
    [JSInvokable]
    public Task OnMeasured(double available, double item, double gap)
    {
        // Guard the re-render: a resize observer fires for every pixel of a window drag, and all
        // but a handful of those land on the same answer.
        if (Math.Abs(available - _available) < 0.5 && Math.Abs(item - _item) < 0.5) return Task.CompletedTask;

        var before = Fit;

        _available = available;
        _item = item;
        _gap = gap;

        return before == Fit ? Task.CompletedTask : InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Dray.Ui/js/dray.js");
        _self = DotNetObjectReference.Create(this);
        _observer = await _module.InvokeAsync<IJSObjectReference>("overflow.attach", _row, _self);
    }

    Task PickAsync(RowAction action) => OnAction.InvokeAsync(action.Id);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                if (_observer is not null) await _module.InvokeVoidAsync("overflow.detach", _observer);

                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit went first — nothing to detach from.
        }

        _self?.Dispose();
    }
}
