@* Pull an image, showing the engine's own per-layer progress.

   Not a single bar. A pull is a dozen layers downloading and extracting at once, and averaging them
   into one number produces a bar that jumps backwards whenever a new layer starts — which reads as
   a bug rather than as progress. *@
@implements IAsyncDisposable
@inject EngineManager Engine
@inject IShellBridge Shell

<Dialog Title="Pull an image" Open="Open" OpenChanged="OnOpenChanged">
    <ChildContent>
        <div class="field">
            <label class="field__label" for="pull-ref">Image</label>
            <input id="pull-ref" class="input" placeholder="nginx:alpine"
                   value="@_reference" @oninput="OnReferenceInput"
                   @onkeydown="OnKeyDown"
                   autocomplete="off" spellcheck="false" disabled="@_pulling" />
        </div>

        @if (_error is { } error)
        {
            <p class="pull__error">@error</p>
        }
        else if (!_pulling && _layers.Count == 0)
        {
            <p class="pull__hint muted">
                A bare name pulls <span class="mono">:latest</span> from Docker Hub. Prefix a host to
                use another registry — <span class="mono">ghcr.io/owner/app:1.2</span>.
            </p>
        }

        @* Search runs as the name is typed, so finding an image and pulling it is one flow rather
           than a browser tab and a copied string. The engine does the searching — it already holds
           the registry configuration and the credentials — and what it searches is Docker Hub:
           there is no search API behind a private registry to offer. *@
        @if (_searching)
        {
            <p class="pull__hint muted">Searching Docker Hub…</p>
        }
        else if (_searchError is { } problem)
        {
            <p class="pull__hint muted">@problem</p>
        }
        else if (_results.Count > 0)
        {
            @* A list of buttons, not a listbox. Each row is an action — "use this name" — rather
               than a value being selected, and role="option" would take the button semantics away
               from a control that is exactly a button. *@
            <ul class="pull__results" aria-label="Images on Docker Hub">
                @foreach (var result in _results)
                {
                    var captured = result;

                    <li>
                        <button type="button" class="pull__result"
                                title="@($"Use {captured.Name}")"
                                @onclick="() => Choose(captured)">
                            <span class="pull__result-name">
                                @result.ShortName

                                @if (result.IsOfficial)
                                {
                                    <span class="pull__badge" title="Published by the project itself">official</span>
                                }
                            </span>

                            @if (result.Stars >= 0)
                            {
                                <span class="pull__stars num muted" title="@($"{result.Stars} stars")">@Humanize.Count(result.Stars)</span>
                            }

                            @if (result.Description is { Length: > 0 } description)
                            {
                                <span class="pull__result-body muted">@description</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        }

        @if (_layers.Count > 0)
        {
            <LayerProgress Layers="Ordered" />
        }

        @if (_done is { } done)
        {
            <p class="pull__done">@done</p>
        }
    </ChildContent>
    <Footer>
        <Button Label="@(_pulling ? "Cancel" : "Close")" Variant="ButtonVariant.Ghost" OnClick="CloseAsync" />
        <Button Label="@(_pulling ? "Pulling…" : "Pull")" Variant="ButtonVariant.Primary"
                Disabled="@(_pulling || string.IsNullOrWhiteSpace(_reference))"
                Busy="_pulling" OnClick="StartAsync" />
    </Footer>
</Dialog>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Raised once a pull finishes, so the list behind can refresh.</summary>
    [Parameter] public EventCallback OnPulled { get; set; }

    string _reference = "";
    string? _error;
    string? _done;
    bool _pulling;
    CancellationTokenSource? _cts;

    /// <summary>
    /// Layers keyed by id, with the order first seen. The engine reports them out of order and
    /// repeatedly; sorting by arrival keeps a row from jumping around as it updates.
    /// </summary>
    readonly Dictionary<string, PullProgress> _layers = new(StringComparer.Ordinal);
    readonly List<string> _order = [];

    IReadOnlyList<PullProgress> Ordered => [.. _order.Select(id => _layers[id])];

    // ---------------------------------------------------------------- search

    IReadOnlyList<ImageSearchResult> _results = [];
    bool _searching;
    string? _searchError;

    /// <summary>The term the last search ran for, so typing the same thing twice does not.</summary>
    string _searched = "";

    CancellationTokenSource? _searchCts;

    bool CanSearch => Engine.Selected?.Capabilities.SupportsRegistrySearch ?? false;

    /// <summary>
    /// Search as the name is typed, after a pause.
    /// <para>
    /// Debounced because this is a network call to Docker Hub on every keystroke otherwise, and
    /// abandoned when the term changes — the answer to a term the user has already typed past is
    /// worse than no answer, because it arrives looking current.
    /// </para>
    /// </summary>
    async Task SearchLaterAsync()
    {
        var term = _reference.Trim();

        // Nothing to search for, or the name is already specific enough that the user knows what
        // they want: a tag or a registry host means they are typing a reference, not looking.
        if (!CanSearch || term.Length < 2 || term.Contains(':') || _pulling)
        {
            _results = [];
            _searchError = null;
            return;
        }

        if (term == _searched) return;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();

        var token = _searchCts.Token;

        try
        {
            await Task.Delay(350, token);

            _searching = true;
            _searchError = null;
            StateHasChanged();

            var found = await Engine.SearchImagesAsync(term, 8, token);

            if (token.IsCancellationRequested) return;

            _searched = term;
            _results = found;

            // "Nothing matched" and "the engine broke" are different sentences, and only one of
            // them is worth retyping the search for.
            _searchError = found.Count == 0 ? $"Nothing on Docker Hub matches “{term}”." : null;
        }
        catch (OperationCanceledException)
        {
            // Typed past it.
        }
        catch (Exception ex)
        {
            _results = [];
            _searchError = ex.Message;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _searching = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Take a result's name as the reference, exactly as the engine gave it.
    /// <para>
    /// Not pulled straight away. The name has no tag, and a click that started downloading
    /// <c>:latest</c> would take the choice of version away from the person making it.
    /// </para>
    /// </summary>
    void Choose(ImageSearchResult result)
    {
        _reference = result.Name;
        _searched = result.Name;
        _results = [];
        _searchError = null;
    }

    async Task OnReferenceInput(ChangeEventArgs e)
    {
        _reference = e.Value?.ToString() ?? "";
        await SearchLaterAsync();
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_pulling && !string.IsNullOrWhiteSpace(_reference)) await StartAsync();
    }

    async Task StartAsync()
    {
        var reference = _reference.Trim();
        if (reference.Length == 0 || _pulling) return;

        _pulling = true;
        _error = null;
        _done = null;
        _layers.Clear();
        _order.Clear();

        _cts = new CancellationTokenSource();

        try
        {
            await foreach (var step in Engine.PullImageAsync(reference, _cts.Token))
            {
                if (step.IsError)
                {
                    // The engine reports failures inside the stream rather than by failing the
                    // request, so this is the only place a bad reference or a login problem shows.
                    _error = step.Error;
                    break;
                }

                if (step.LayerId is { } id)
                {
                    if (!_layers.ContainsKey(id)) _order.Add(id);
                    _layers[id] = step;
                }

                StateHasChanged();
            }

            if (_error is null)
            {
                _done = $"Pulled {reference}.";

                // Only lands if the window is not in front — see WebShellBridge.NotifyAsync. A pull
                // is the archetypal "started it and went to do something else" operation.
                await Shell.NotifyAsync("Pull finished", $"{reference} is on {Engine.Selected?.Name}.", NoticeKind.Success);

                await OnPulled.InvokeAsync();
            }
            else
            {
                await Shell.NotifyAsync("Pull failed", $"{reference}: {_error}", NoticeKind.Error);
            }
        }
        catch (OperationCanceledException)
        {
            _done = "Pull cancelled.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _pulling = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    async Task CloseAsync()
    {
        // Cancelling the stream stops Dray reading it; the engine finishes the pull it started.
        // Saying otherwise would be a lie, and a half-pulled image is not a state Dray can create.
        if (_cts is { } cts) await cts.CancelAsync();

        await OpenChanged.InvokeAsync(false);
    }

    async Task OnOpenChanged(bool open)
    {
        if (!open) await CloseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is { } cts)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }

        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
