@* Run a container from an image.

   Four fields, not forty. `docker run` has over a hundred flags; a form offering them all is one
   nobody can complete and a set of choices nobody can evaluate. These are what someone types when
   they want a database up — a name to find it by, a port to reach it on, the environment it needs
   to boot, and somewhere for its data to live. Anything more specific belongs in a compose file,
   which Dray can already bring up.

   Every box takes the syntax people already have in their shell history, because a dialog that
   invented its own would be one people retype things for. *@
@inject EngineManager Engine

<Dialog Title="Run a container" Class="run" Open="Open" OpenChanged="OpenChanged">
    <ChildContent>
        <div class="field">
            <label class="field__label" for="run-image">Image</label>

            @* Free text is a valid answer — an image not on this host is pulled — so this ranks
               what is here rather than restricting to it. *@
            <Combobox TItem="ImageChoice"
                      Label="Image"
                      Placeholder="postgres:16"
                      InputClass="mono"
                      Query="@_image"
                      QueryChanged="@(v => _image = v)"
                      Source="SearchImagesAsync"
                      LabelOf="i => i.Reference"
                      HaystackOf="i => i.Haystack"
                      KeyOf="i => i.Reference"
                      EmptyText="Not on this host — running it will pull it first.">
                <Row Context="match">
                    <span class="mono run__opt-name">
                        <Highlighted Text="@match.Value.Reference" Highlights="match.Highlights" />
                    </span>
                    <span class="muted run__opt-meta">@match.Value.Detail</span>
                </Row>
            </Combobox>
        </div>

        <div class="field">
            <label class="field__label" for="run-name">
                Name <span class="muted">(optional — the engine invents one otherwise)</span>
            </label>
            <input id="run-name" class="input" placeholder="my-database"
                   @bind="_name" @bind:event="oninput" autocomplete="off" spellcheck="false" />
        </div>

        <div class="field">
            <span class="field__label">Ports</span>
            <PortEditor Ports="_ports" PortsChanged="@(p => _ports = p)" />
        </div>

        <div class="field">
            <span class="field__label">Environment</span>
            <EnvEditor Variables="_env" VariablesChanged="@(v => _env = v)" />
        </div>

        <div class="field">
            <span class="field__label">Mounts</span>
            <MountEditor Mounts="_mounts" MountsChanged="@(m => _mounts = m)" />
        </div>

        <label class="toggle">
            <input type="checkbox" @bind="_start" />
            <span>Start it now — leave this off to create it and look at it first</span>
        </label>

        @if (Problem is { } problem)
        {
            <p class="run__problem" role="alert">@problem</p>
        }
    </ChildContent>
    <Footer>
        <Button Label="Cancel" Variant="ButtonVariant.Ghost" Disabled="_running"
                OnClick="() => OpenChanged.InvokeAsync(false)" />
        <Button Label="@(_start ? "Run" : "Create")" Variant="ButtonVariant.Primary" Busy="_running"
                Disabled="@(_running || _image.Trim().Length == 0)" OnClick="SubmitAsync" />
    </Footer>
</Dialog>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Pre-filled when the dialog is opened from a specific image's row.</summary>
    [Parameter] public string? Image { get; set; }

    /// <summary>Raised with the new container's id once the engine has accepted it.</summary>
    [Parameter] public EventCallback<string> OnStarted { get; set; }

    string _image = "";
    string _name = "";

    IReadOnlyList<PortBinding> _ports = [];
    IReadOnlyList<EnvVar> _env = [];
    IReadOnlyList<MountPoint> _mounts = [];
    bool _start = true;
    bool _running;

    string? _failure;
    IReadOnlyList<ImageChoice> _local = [];

    /// <summary>
    /// One offerable image. Carries its own haystack so a search matches on the repository and the
    /// short id as well as on the reference the row shows.
    /// </summary>
    sealed record ImageChoice(string Reference, string Detail, string Haystack);

    /// <summary>
    /// What is wrong right now — the first unreadable line, or the engine's refusal.
    /// <para>
    /// Recomputed on every render rather than on submit, so a mistyped port is flagged while the
    /// user is still looking at the box rather than after they commit.
    /// </para>
    /// </summary>
    string? Problem
    {
        get
        {
            if (_failure is { } failure) return failure;

            // Ports, environment and mounts validate as they are entered now — each editor
            // refuses to add a row it cannot make sense of — so nothing here re-checks them.
            return _name.Trim().Length > 0 ? ContainerName.Validate(_name.Trim()) : null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Image is { Length: > 0 } image && _image.Length == 0) _image = image;

        if (Open && _local.Count == 0) await LoadLocalAsync();
    }

    /// <summary>
    /// The images on this host, read once when the dialog opens.
    /// <para>
    /// Not re-read per keystroke: the list does not change while a dialog is open, and the
    /// combobox ranks it locally. A registry search — which does need a call per query — is the
    /// outstanding Phase 6 item and slots in below these.
    /// </para>
    /// </summary>
    async Task LoadLocalAsync()
    {
        var images = await Engine.ListImagesAsync();

        _local =
        [
            .. images
                .SelectMany(i => i.Tags.Select(t => new ImageChoice(
                    t.Display,
                    $"{Humanize.Bytes(i.SizeBytes)}{(i.IsInUse is true ? $" · {i.ContainerCount} in use" : "")}",
                    $"{t.Display} {t.ShortRepository} {i.ShortId}".ToLowerInvariant())))
                .Where(c => !c.Reference.StartsWith("<untagged>", StringComparison.Ordinal))
                .DistinctBy(c => c.Reference),
        ];
    }

    Task<IReadOnlyList<ImageChoice>> SearchImagesAsync(string query, CancellationToken ct)
        => Task.FromResult(_local);

    async Task SubmitAsync()
    {
        _failure = null;

        if (Problem is not null) return;

        _running = true;

        try
        {
            var request = new RunRequest
            {
                Image = _image.Trim(),
                Name = _name.Trim() is { Length: > 0 } name ? name : null,
                Ports = _ports,
                Environment = _env,
                Mounts = _mounts,

                // Whatever the user marked rides along as labels, so the masking survives the
                // container's whole life rather than only this dialog.
                Labels = SecretMarks.ToLabels(_env),
                Start = _start,
            };

            _failure = await Engine.RunAsync(request);

            if (_failure is null)
            {
                await OnStarted.InvokeAsync(request.Name ?? request.Image);
                await OpenChanged.InvokeAsync(false);
                Reset();
            }
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>Cleared on success so reopening the dialog does not offer to run the same thing twice.</summary>
    void Reset()
    {
        _image = "";
        _name = "";
        _ports = [];
        _env = [];
        _mounts = [];
        _start = true;
        _local = [];
    }
}
