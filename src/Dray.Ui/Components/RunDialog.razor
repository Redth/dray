@* Run a container from an image.

   Four fields, not forty. `docker run` has over a hundred flags; a form offering them all is one
   nobody can complete and a set of choices nobody can evaluate. These are what someone types when
   they want a database up — a name to find it by, a port to reach it on, the environment it needs
   to boot, and somewhere for its data to live. Anything more specific belongs in a compose file,
   which Dray can already bring up.

   Every box takes the syntax people already have in their shell history, because a dialog that
   invented its own would be one people retype things for. *@
@inherits DialogBody
@inject EngineManager Engine

<div class="field">
    <label class="field__label" for="run-image">Image</label>

    @* Free text is a valid answer — an image not on this host is pulled — so this ranks
       what is here rather than restricting to it. *@
    <Combobox TItem="ImageChoice"
              Label="Image"
              Placeholder="postgres:16"
              InputClass="mono"
              Query="@_image"
              QueryChanged="@(v => _image = v)"
              Source="SearchImagesAsync"
              DebounceMs="350"
              GroupOf="i => i.IsLocal ? 0 : 1"
              LabelOf="i => i.Reference"
              HaystackOf="i => i.Haystack"
              KeyOf="i => i.Reference"
              EmptyText="Not on this host — running it will pull it first.">
        <Row Context="match">
            <span class="mono run__opt-name">
                <Highlighted Text="@match.Value.Reference" Highlights="match.Highlights" />
            </span>
            <span class="muted run__opt-meta">@match.Value.Detail</span>
        </Row>
    </Combobox>
</div>

<div class="field">
    <label class="field__label" for="run-name">
        Name <span class="muted">(optional — the engine invents one otherwise)</span>
    </label>
    <input id="run-name" class="input" placeholder="my-database"
           @bind="_name" @bind:event="oninput" autocomplete="off" spellcheck="false" />
</div>

<div class="field">
    <span class="field__label">Ports</span>
    <PortEditor Ports="_ports" PortsChanged="@(p => _ports = p)" />
</div>

<div class="field">
    <span class="field__label">Environment</span>
    <EnvEditor Variables="_env" VariablesChanged="@(v => _env = v)" />
</div>

<div class="field">
    <span class="field__label">Mounts</span>
    <MountEditor Mounts="_mounts" MountsChanged="@(m => _mounts = m)" />
</div>

<label class="toggle">
    <input type="checkbox" @bind="_start" />
    <span>Start it now — leave this off to create it and look at it first</span>
</label>

@if (Problem is { } problem)
{
    <p class="run__problem" role="alert">@problem</p>
}

@code {
    /// <summary>
    /// Open it, pre-filled with <paramref name="image"/> when opened from an image's row. Returns
    /// the new container's name — or its image, when the engine invented the name — once the engine
    /// has accepted it, or null when the dialog was cancelled.
    /// </summary>
    public static async Task<string?> ShowAsync(IShellBridge shell, string? image = null)
    {
        var session = new DialogSession(new DialogRequest(
            "Run a container",
            typeof(RunDialog),
            Parameters: new Dictionary<string, object?> { [nameof(Image)] = image },
            Buttons: [DialogButton.Cancel(), DialogButton.Confirm("run", "Run")],

            // Wider than a plain form: three of these fields are multi-line, and a narrow box turns
            // a two-column port mapping into something that wraps.
            Size: DialogSize.Large));
        await shell.ShowDialogAsync(session);

        return session.Result == "run" ? session.Value as string : null;
    }

    /// <summary>Pre-filled when the dialog is opened from a specific image's row.</summary>
    [Parameter] public string? Image { get; set; }

    protected override IReadOnlyList<DialogButton> Buttons =>
    [
        DialogButton.Cancel("Cancel") with { Enabled = !_running },
        DialogButton.Confirm("run", _start ? "Run" : "Create") with { Enabled = !_running && _image.Trim().Length > 0, Busy = _running },
    ];

    protected override async Task<bool> OnPressedAsync(string buttonId)
    {
        if (buttonId == "run")
        {
            await SubmitAsync();

            // An unusable name stops the run before the engine is asked, and clears the last
            // refusal without passing the re-render in SubmitAsync's finally.
            StateHasChanged();

            // A run closes the dialog itself, and only once the engine has accepted it.
            return false;
        }

        return true;
    }

    string _image = "";
    string _name = "";

    IReadOnlyList<PortBinding> _ports = [];
    IReadOnlyList<EnvVar> _env = [];
    IReadOnlyList<MountPoint> _mounts = [];
    bool _start = true;
    bool _running;

    string? _failure;
    IReadOnlyList<ImageChoice> _local = [];

    /// <summary>
    /// One offerable image. Carries its own haystack so a search matches on the repository and the
    /// short id as well as on the reference the row shows.
    /// </summary>
    /// <param name="IsLocal">
    /// Already on this host. Decides which half of the dropdown it sits in: an image that is here
    /// starts in seconds, and one that is not has to be pulled first.
    /// </param>
    sealed record ImageChoice(string Reference, string Detail, string Haystack, bool IsLocal = false);

    /// <summary>
    /// What is wrong right now — the first unreadable line, or the engine's refusal.
    /// <para>
    /// Recomputed on every render rather than on submit, so a mistyped port is flagged while the
    /// user is still looking at the box rather than after they commit.
    /// </para>
    /// </summary>
    string? Problem
    {
        get
        {
            if (_failure is { } failure) return failure;

            // Ports, environment and mounts validate as they are entered now — each editor
            // refuses to add a row it cannot make sense of — so nothing here re-checks them.
            return _name.Trim().Length > 0 ? ContainerName.Validate(_name.Trim()) : null;
        }
    }

    // Once, when the dialog opens. Not in OnParametersSetAsync: the host re-renders the body
    // whenever a button changes, which would refill an image field the user had cleared.
    protected override async Task OnInitializedAsync()
    {
        if (Image is { Length: > 0 } image) _image = image;

        await LoadLocalAsync();
    }

    /// <summary>
    /// The images on this host, read once when the dialog opens.
    /// <para>
    /// Not re-read per keystroke: the list does not change while a dialog is open, and the
    /// combobox ranks it locally. The registry search below it does need a call per query, which
    /// is what the combobox's debounce is for.
    /// </para>
    /// </summary>
    async Task LoadLocalAsync()
    {
        var images = await Engine.ListImagesAsync();

        _local =
        [
            .. images
                .SelectMany(i => i.Tags.Select(t => new ImageChoice(
                    t.Display,
                    $"{Humanize.Bytes(i.SizeBytes)}{(i.IsInUse is true ? $" · {i.ContainerCount} in use" : "")}",
                    $"{t.Display} {t.ShortRepository} {i.ShortId}".ToLowerInvariant(),
                    IsLocal: true)))
                .Where(c => !c.Reference.StartsWith("<untagged>", StringComparison.Ordinal))
                .DistinctBy(c => c.Reference),
        ];
    }

    /// <summary>
    /// Local images first, then what the registry has.
    /// <para>
    /// One dropdown rather than two search boxes: from the user's side "which image" is one
    /// question, and whether the answer is already on this machine is an attribute of the answer
    /// rather than a different question. Local first because an image that is here starts in
    /// seconds and one that is not has to be pulled.
    /// </para>
    /// <para>
    /// The registry is only asked once there is something worth asking about, and never for a
    /// reference that already names a tag or a host — at that point the user is typing a specific
    /// image, not looking for one.
    /// </para>
    /// </summary>
    async Task<IReadOnlyList<ImageChoice>> SearchImagesAsync(string query, CancellationToken ct)
    {
        var term = query.Trim();

        // Local images are filtered on substring rather than left to the fuzzy ranker. Subsequence
        // matching is right for commands, where "rsc" should find "Restart container"; for an
        // image reference it puts mcr.microsoft.com/dotnet/sdk under "redis" — r, e, d, i, s all
        // appear in it — and grouping local first would then rank that above the real answer.
        var local = term.Length == 0
            ? _local
            : [.. _local.Where(c => c.Haystack.Contains(term, StringComparison.OrdinalIgnoreCase))];

        var searchable = term.Length >= 2
            && !term.Contains(':')
            && !term.Contains('/')
            && (Engine.Selected?.Capabilities.SupportsRegistrySearch ?? false);

        if (!searchable) return local;

        try
        {
            var remote = await Engine.SearchImagesAsync(term, 6, ct: ct);

            // Anything already here is already in the list above, and the registry's name for it
            // is usually a longer spelling of the same thing.
            var known = local.Select(c => c.Reference).ToHashSet(StringComparer.OrdinalIgnoreCase);

            return
            [
                .. local,
                .. remote
                    .Where(r => !known.Contains(r.Name) && !known.Contains(r.Name + ":latest"))
                    .Select(r => new ImageChoice(
                        r.Name,
                        r.IsOfficial ? "Docker Hub · official" : "Docker Hub",
                        $"{r.Name} {r.ShortName} {r.Description}".ToLowerInvariant())),
            ];
        }
        catch (Exception)
        {
            // No registry, no network, or an engine that would not answer. The local list is still
            // a useful answer, and a dropdown is the wrong place to report a search failure.
            return local;
        }
    }

    async Task SubmitAsync()
    {
        _failure = null;

        if (Problem is not null) return;

        _running = true;

        // Submitted from the head's button, and only an event handler re-renders by itself — so
        // the buttons learn they are busy from here.
        StateHasChanged();

        try
        {
            var request = new RunRequest
            {
                Image = _image.Trim(),
                Name = _name.Trim() is { Length: > 0 } name ? name : null,
                Ports = _ports,
                Environment = _env,
                Mounts = _mounts,

                // Whatever the user marked rides along as labels, so the masking survives the
                // container's whole life rather than only this dialog.
                Labels = SecretMarks.ToLabels(_env),
                Start = _start,
            };

            _failure = await Engine.RunAsync(request);

            if (_failure is null) Close("run", request.Name ?? request.Image);
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }
}
