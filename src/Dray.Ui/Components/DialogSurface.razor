@* The body of a native dialog, and nothing else.

   Mounted as the root component of the WebView a native head puts inside its own dialog chrome —
   an NSAlert's accessory view on macOS. It draws no title and no buttons, because those are the
   platform's and drawing them here is the bug docs/NATIVE-SHELL.md section 4 exists to prevent. *@
@implements IDisposable
@inject NativeDialogState State

<div class="surface">
    @if (State.Current is { } request)
    {
        <DynamicComponent Type="request.Body" Parameters="Writable(request.ParameterMap)" />
    }
</div>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    static Dictionary<string, object> Writable(IReadOnlyDictionary<string, object?> parameters)
    {
        var copy = new Dictionary<string, object>(StringComparer.Ordinal);

        foreach (var (key, value) in parameters)
        {
            if (value is not null) copy[key] = value;
        }

        return copy;
    }

    public void Dispose() => State.Changed -= OnChanged;
}
