@* A container's output.

   Streams for as long as it is on screen and stops when it is not — the stream belongs to the view
   (docs/ARCHITECTURE.md §3), so navigating away does not leave a connection open against the
   engine. *@
@implements IAsyncDisposable
@inject EngineManager Engine
@inject IShellBridge Shell
@inject IJSRuntime JS

<div class="log">
    <div class="log__bar chrome">
        @* Timestamps and stream separation are the engine's to provide. Where it provides
           neither, these two toggles are switches wired to nothing — one would change no line on
           screen and the other would empty the view. Wrap is Dray's own and always applies. *@
        @if (HasLogMetadata)
        {
            <label class="toggle">
                <input type="checkbox" @bind="_showTimestamps" />
                <span>Timestamps</span>
            </label>
        }
        <label class="toggle">
            <input type="checkbox" @bind="_wrap" />
            <span>Wrap</span>
        </label>
        @if (HasLogMetadata)
        {
            <label class="toggle">
                <input type="checkbox" @bind="_stderrOnly" />
                <span>stderr only</span>
            </label>
        }

        <input class="input log__filter" type="search" placeholder="Filter lines"
               @bind="_filter" @bind:event="oninput" />

        <span class="log__count muted">@Filtered.Count / @_lines.Count</span>

        <Button Label="Copy" Icon="IconRef.Copy" Variant="ButtonVariant.Ghost" IconOnly="true" OnClick="CopyAsync" />
    </div>

    <div class="log__body mono" @ref="_scroller">
        @if (_lines.Count == 0)
        {
            <div class="log__empty muted">
                @(_streaming ? "Waiting for output…" : "This container has produced no output.")
            </div>
        }
        else
        {
            @foreach (var line in Filtered)
            {
                <div class="log__line @LineClass(line)" @key="line.Sequence">
                    @if (_showTimestamps && line.Timestamp is { } ts)
                    {
                        @* One column, always filled. Where the program printed its own clock it is
                           lifted out of the message below and the engine's shown here instead —
                           the same instant, rendered once, in the user's timezone. *@
                        <span class="log__ts">@ts.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                    }
                    @* Escapes become spans; everything else stays text. The converted HTML is
                       escaped by the converter, because container output is the least trusted
                       string in the app. *@
                    @if (_coloured.TryGetValue(line.Sequence, out var html))
                    {
                        <span class="log__text">@((MarkupString)html)</span>
                    }
                    else
                    {
                        <span class="log__text">@Message(line)</span>
                    }
                </div>
            }
        }
    </div>

    @if (!_following)
    {
        <button type="button" class="log__jump" @onclick="JumpToLatestAsync">
            <Icon Name="IconRef.ChevronDown" Size="IconSize.Sm" />
            Jump to latest
        </button>
    }

    @if (_truncated)
    {
        <div class="log__truncated muted">
            Showing the most recent @MaxLines lines. Older output is still in the engine.
        </div>
    }
</div>

@code {
    /// <summary>
    /// A hard cap on what is held in memory. A chatty container can produce output faster than
    /// anyone can read it, and an unbounded buffer would grow until the app died. The banner says
    /// so rather than silently dropping history.
    /// </summary>
    const int MaxLines = 5_000;

    [Parameter, EditorRequired] public ContainerSummary Container { get; set; } = default!;

    readonly List<LogLine> _lines = [];

    ElementReference _scroller;
    IJSObjectReference? _module;
    IJSObjectReference? _scrollState;
    DotNetObjectReference<LogView>? _self;

    CancellationTokenSource? _cts;
    Task? _pump;
    string? _streamingFor;

    /// <summary>Whether the engine attaches a timestamp and a stream to each line.</summary>
    bool HasLogMetadata => Engine.Selected?.Capabilities.SupportsLogMetadata ?? true;

    bool _showTimestamps = true;
    bool _wrap;
    bool _stderrOnly;
    bool _following = true;
    bool _streaming;
    bool _truncated;
    string _filter = "";

    IReadOnlyList<LogLine> Filtered
    {
        get
        {
            IEnumerable<LogLine> q = _lines;

            if (_stderrOnly) q = q.Where(l => l.Stream == LogStream.StdErr);

            if (!string.IsNullOrWhiteSpace(_filter))
            {
                // Matched against the line without its escapes, so a search for "31" cannot hit
                // the red in ESC[31m and a search for a word is not defeated by a colour change
                // in the middle of it.
                var needle = _filter.Trim();
                q = q.Where(l => AnsiText.Strip(l.Text).Contains(needle, StringComparison.OrdinalIgnoreCase));
            }

            return [.. q];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Switching containers restarts the stream; a re-render for any other reason must not.
        if (_streamingFor == Container.Id) return;

        _streamingFor = Container.Id;
        await RestartStreamAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Dray.Ui/js/dray.js");
            _self = DotNetObjectReference.Create(this);
            _scrollState = await _module.InvokeAsync<IJSObjectReference>("logs.attach", _scroller, _self);
        }

        // A no-op while the user is reading history further up.
        if (_module is not null && _scrollState is not null)
            await _module.InvokeVoidAsync("logs.followIfAttached", _scrollState);
    }

    /// <summary>Called from JS when the user scrolls away from, or back to, the bottom.</summary>
    [JSInvokable]
    public Task OnFollowChanged(bool following)
    {
        _following = following;
        return InvokeAsync(StateHasChanged);
    }

    async Task RestartStreamAsync()
    {
        await StopStreamAsync();

        _lines.Clear();
        _truncated = false;
        _following = true;
        _streaming = true;

        _cts = new CancellationTokenSource();
        _pump = PumpAsync(Container.Id, _cts.Token);
    }

    /// <summary>
    /// What the line says, with its own timestamp lifted out where the column is showing the
    /// engine's. With the column off, the line is left exactly as the program wrote it — there is
    /// then nothing duplicating it.
    /// </summary>
    string Message(LogLine line)
        => _showTimestamps && line.Timestamp is not null
            ? LogTimestamps.WithoutItsOwn(line.Text)
            : line.Text;

    /// <summary>
    /// The row's classes: which stream it came from, and what the program called it.
    /// <para>
    /// stderr and severity are different questions. A program can log an error to stdout and its
    /// ordinary progress to stderr, and plenty do.
    /// </para>
    /// </summary>
    string LineClass(LogLine line)
    {
        var stream = line.Stream == LogStream.StdErr ? "is-stderr" : null;

        var level = LogSeverity.Of(Message(line)) switch
        {
            LogLevel.Error => "is-error",
            LogLevel.Warning => "is-warn",
            LogLevel.Debug => "is-debug",
            _ => null,
        };

        return string.Join(' ', new[] { stream, level }.Where(c => c is not null));
    }

    /// <summary>Sequence number to the HTML its escapes became.</summary>
    readonly Dictionary<long, string> _coloured = [];

    async Task ColourAsync(LogLine line)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Dray.Ui/js/dray.js");

        try
        {
            // One line per call, and the argument is a string rather than an array: InvokeAsync
            // takes params object?[], so handing it a string[] spreads the elements into separate
            // arguments instead of passing one array.
            var html = await _module.InvokeAsync<string>("ansi.render", line.Text);

            if (!string.IsNullOrEmpty(html)) _coloured[line.Sequence] = html;
        }
        catch (JSException)
        {
            // A line Dray could not colour is still a line. It renders as text, escapes and all,
            // which is what it did before there was a converter.
        }
    }

    async Task PumpAsync(string containerId, CancellationToken ct)
    {
        try
        {
            await foreach (var line in Engine.StreamLogsAsync(containerId, LogOptions.Default, ct))
            {
                _lines.Add(line);

                // Only lines that actually carry escapes cost anything: the check is a string scan
                // in C# and the conversion is one interop call for the line that needs it. On the
                // overwhelming majority of output this does nothing at all.
                if (AnsiText.Contains(line.Text)) await ColourAsync(line);

                if (_lines.Count > MaxLines)
                {
                    // Drop from the front in one go rather than per line: removing a single item
                    // from the head of a List is O(n), and doing that per line on a busy container
                    // is the difference between smooth and unusable.
                    _lines.RemoveRange(0, _lines.Count - MaxLines);
                    _truncated = true;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigating away or switching containers.
        }
        catch (Exception ex)
        {
            _lines.Add(new LogLine(null, LogStream.StdErr, $"— log stream ended: {RuntimeEventPump.Describe(ex)}", long.MaxValue));
        }
        finally
        {
            _streaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task StopStreamAsync()
    {
        if (_cts is null) return;

        await _cts.CancelAsync();

        if (_pump is not null)
        {
            try
            {
                await _pump;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _cts.Dispose();
        _cts = null;
        _pump = null;
    }

    async Task JumpToLatestAsync()
    {
        if (_module is null || _scrollState is null) return;
        await _module.InvokeVoidAsync("logs.scrollToBottom", _scrollState);
    }

    async Task CopyAsync()
    {
        var text = string.Join(
            '\n',
            // Stripped, because escape bytes on the clipboard paste as gibberish anywhere but a
            // terminal — and the timestamp is left off a line that prints its own, for the same
            // reason it is not drawn.
            Filtered.Select(l => _showTimestamps && l.Timestamp is { } ts && !LogTimestamps.CarriesItsOwn(l.Text)
                ? $"{ts.ToLocalTime():HH:mm:ss.fff} {AnsiText.Strip(l.Text)}"
                : AnsiText.Strip(l.Text)));

        await Shell.WriteClipboardAsync(text);
    }

    public async ValueTask DisposeAsync()
    {
        await StopStreamAsync();

        try
        {
            if (_module is not null && _scrollState is not null)
                await _module.InvokeVoidAsync("logs.detach", _scrollState);

            if (_scrollState is not null) await _scrollState.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away first; nothing to release.
        }

        _self?.Dispose();
    }
}
