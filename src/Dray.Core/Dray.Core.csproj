<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dray.Core</RootNamespace>
    <Description>Dray domain, state store and services. References neither Docker nor a UI framework.</Description>
  </PropertyGroup>

  <!-- Generated + gitignored. Fail loudly rather than producing a confusing CS0246 wall. -->
  <Target Name="_EnsureGeneratedSources" BeforeTargets="BeforeCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Theme/Tokens.g.cs')"
           Text="Theme/Tokens.g.cs is missing. Run: node build/gen-tokens.mjs" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Shell/Icons.g.cs')"
           Text="Shell/Icons.g.cs is missing. Run: node build/gen-icons.mjs" />
  </Target>

</Project>
