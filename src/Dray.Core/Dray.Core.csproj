<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dray.Core</RootNamespace>
    <Description>Dray domain, state store and services. References neither Docker nor a UI framework.</Description>
  </PropertyGroup>

  <!-- Theme/Tokens.g.cs is generated by build/gen-tokens.mjs and gitignored.
       Fail loudly rather than producing a confusing CS0246 wall. -->
  <Target Name="_EnsureTokensGenerated" BeforeTargets="BeforeCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Theme/Tokens.g.cs')"
           Text="Theme/Tokens.g.cs is missing. Run: node build/gen-tokens.mjs" />
  </Target>

</Project>
