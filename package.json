{
  "name": "dray-build",
  "private": true,
  "description": "Build-time tooling only. Dray ships no JavaScript dependencies at runtime beyond the vendored editor.",
  "type": "module",
  "scripts": {
    "vendor:monaco": "node build/vendor-monaco.mjs",
    "check:monaco": "node build/vendor-monaco.mjs --check",
    "vendor:xterm": "node build/vendor-xterm.mjs",
    "check:xterm": "node build/vendor-xterm.mjs --check",
    "vendor:tabulator": "node build/vendor-tabulator.mjs",
    "check:tabulator": "node build/vendor-tabulator.mjs --check"
  },
  "devDependencies": {
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "5.5.0",
    "monaco-editor": "0.55.0",
    "tabulator-tables": "^6.3.1"
  }
}
